{%- liquid
  assign st = section.settings

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
-%}
<style>
  #m-section--{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top | default: 12 }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom | default: 36 }}px;
    padding-top: var(--section-padding-top) !important;
    padding-bottom: var(--section-padding-bottom) !important;
  }
  #m-section--{{ section.id }} .m-section-py {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  #m-section--{{ section.id }} .container {
    max-width: 900px !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
  }

  /* Form Container Width & Elegance */
  #m-section--{{ section.id }} .m-contact-form__main {
    max-width: 520px !important;
    width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Headings & Descriptions */
  #m-section--{{ section.id }} .m-contact-form__heading {
    font-family: var(--font-stack-header), "Playfair Display", Didot, "Bodoni MT", Georgia, serif !important;
    font-weight: 400 !important;
    letter-spacing: 1.5px !important;
    line-height: 1.3 !important;
    color: rgb(var(--color-heading, 26, 26, 26)) !important;
    font-size: 24px !important;
    margin-bottom: 8px !important;
    text-align: center !important;
  }
  @media(max-width:767px){
    #m-section--{{ section.id }} .m-contact-form__heading {
    font-family: var(--font-stack-header), "Playfair Display", Didot, "Bodoni MT", Georgia, serif !important;
    font-weight: 400 !important;
    letter-spacing: 0.8px !important;
    line-height: 1.3 !important;
    color: rgb(var(--color-heading, 26, 26, 26)) !important;
    font-size: 16px !important;
    margin-bottom: 8px !important;
    text-align: center !important;
  }
  }
  #m-section--{{ section.id }} .m-contact-form__description {
    font-family: var(--font-stack-body), "Jost", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: #555555 !important;
    text-align: center !important;
    max-width: 460px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    margin-bottom: 20px !important;
  }
  #m-section--{{ section.id }} .m-contact-form__description p {
    margin-bottom: 0 !important;
  }

  /* Proportional & Properly Aligned Name & Email Fields */
  #m-section--{{ section.id }} .m-contact-form__form-fields {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 14px !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 100% !important;
  }
  #m-section--{{ section.id }} .m-contact-form__name,
  #m-section--{{ section.id }} .m-contact-form__email {
    flex: 1 1 calc(50% - 7px) !important;
    width: calc(50% - 7px) !important;
    max-width: calc(50% - 7px) !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  #m-section--{{ section.id }} .m-contact-form__phone {
    flex: 1 1 100% !important;
    width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Form Field Inputs */
  #m-section--{{ section.id }} .form-field--input {
    width: 100% !important;
    border: 1px solid rgba(0, 0, 0, 0.14) !important;
    background-color: #ffffff !important;
    border-radius: 2px !important;
    padding: 9px 13px !important;
    font-size: 13.5px !important;
    line-height: 1.4 !important;
    color: #222222 !important;
    box-sizing: border-box !important;
    font-family: var(--font-stack-body), "Jost", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  }
  #m-section--{{ section.id }} input.form-field--input {
    height: 40px !important;
  }
  #m-section--{{ section.id }} .form-field--input::placeholder {
    font-size: 13px !important;
    color: #888888 !important;
    opacity: 1 !important;
  }
  #m-section--{{ section.id }} .form-field--input:focus {
    border-color: #1a1a1a !important;
    box-shadow: 0 0 0 1px #1a1a1a !important;
    outline: none !important;
  }

  /* Significantly Reduced Message Box Height & Clean Alignment */
  #m-section--{{ section.id }} .m-contact-form__message {
    width: 100% !important;
    margin-top: 14px !important;
    margin-bottom: 0 !important;
    padding: 0 !important;
  }
  #m-section--{{ section.id }} .m-contact-form__message textarea {
    height: 86px !important;
    min-height: 86px !important;
    max-height: 150px !important;
    resize: vertical !important;
    line-height: 1.45 !important;
    padding: 10px 13px !important;
  }

  /* Compact & Refined Submit Button */
  #m-section--{{ section.id }} .m-contact-form__submit-wrapper {
    display: flex !important;
    justify-content: center !important;
    width: 100% !important;
    margin-top: 18px !important;
  }
  #m-section--{{ section.id }} .m-contact-form__submit-btn {
    padding: 8px 30px !important;
    font-size: 11.5px !important;
    font-weight: 500 !important;
    letter-spacing: 1.2px !important;
    text-transform: uppercase !important;
    line-height: 1.2 !important;
    height: 38px !important;
    min-height: 38px !important;
    width: fit-content !important;
    max-width: max-content !important;
    border-radius: 2px !important;
    background-color: #1a1a1a !important;
    color: #ffffff !important;
    border: 1px solid #1a1a1a !important;
    cursor: pointer !important;
    transition: background-color 0.25s ease, opacity 0.25s ease !important;
  }
  #m-section--{{ section.id }} .m-contact-form__submit-btn:hover {
    background-color: #383838 !important;
    border-color: #383838 !important;
    opacity: 0.95 !important;
  }

  /* Contact Details & Info Block */
  .m-contact-email-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    font-size: 14px;
    line-height: 1.4;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .m-contact-email-link:hover {
    opacity: 0.7;
  }
  .m-contact-email-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: currentColor;
    display: inline-block;
  }
  #m-section--{{ section.id }} .m-info-box__title {
    font-family: var(--font-stack-header), "Playfair Display", Didot, serif !important;
    font-weight: 400 !important;
    letter-spacing: 1.2px !important;
    text-transform: uppercase !important;
    font-size: 15px !important;
    margin-bottom: 6px !important;
  }

  /* Desktop View (>= 1024px) */
  @media (min-width: 1024px) {
    #m-section--{{ section.id }} .m-row {
      display: flex !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      align-items: flex-start !important;
      gap: 50px !important;
      max-width: 820px !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    #m-section--{{ section.id }} .m-contact-form__main {
      max-width: 500px !important;
      flex: 1 1 500px !important;
      margin: 0 !important;
    }
    #m-section--{{ section.id }} .m-contact-form__heading,
    #m-section--{{ section.id }} .m-contact-form__description {
      text-align: left !important;
      margin-left: 0 !important;
    }
    #m-section--{{ section.id }} .m-contact-form__submit-wrapper {
      justify-content: flex-start !important;
    }
    #m-section--{{ section.id }} .m-contact-form__info {
      flex: 0 0 230px !important;
      width: 230px !important;
      padding-top: 8px !important;
      padding-left: 36px !important;
      border-left: 1px solid rgba(0, 0, 0, 0.08) !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 16px !important;
      margin: 0 !important;
    }
    #m-section--{{ section.id }} .m-contact-form__info .m-info-box {
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }
  }

  /* Tablet View (768px - 1023px, iPad portrait and landscape) */
  @media (max-width: 1023px) {
    #m-section--{{ section.id }} .m-row {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      max-width: 520px !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    #m-section--{{ section.id }} .m-contact-form__main {
      max-width: 520px !important;
      width: 100% !important;
      margin: 0 auto !important;
      padding: 0 !important;
    }
    #m-section--{{ section.id }} .m-contact-form__heading,
    #m-section--{{ section.id }} .m-contact-form__description {
      text-align: center !important;
    }
    #m-section--{{ section.id }} .m-contact-form__message textarea {
      height: 84px !important;
      min-height: 84px !important;
    }
    #m-section--{{ section.id }} .m-contact-form__info {
      width: 100% !important;
      max-width: 520px !important;
      margin-top: 28px !important;
      padding-top: 20px !important;
      border-top: 1px solid rgba(0, 0, 0, 0.08) !important;
      display: flex !important;
      flex-direction: row !important;
      justify-content: center !important;
      align-items: center !important;
      flex-wrap: wrap !important;
      gap: 24px !important;
      padding-left: 0 !important;
      border-left: none !important;
    }
    #m-section--{{ section.id }} .m-contact-form__info .m-info-box {
      width: auto !important;
      padding: 0 !important;
      margin: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
    }
  }

  /* Mobile View (<= 575px) */
  @media (max-width: 575px) {
    #m-section--{{ section.id }} .m-contact-form__form-fields {
      flex-direction: column !important;
      gap: 12px !important;
    }
    #m-section--{{ section.id }} .m-contact-form__name,
    #m-section--{{ section.id }} .m-contact-form__email {
      flex: 1 1 100% !important;
      width: 100% !important;
      max-width: 100% !important;
    }
    #m-section--{{ section.id }} .m-contact-form__message textarea {
      height: 80px !important;
      min-height: 80px !important;
    }
    #m-section--{{ section.id }} .m-contact-form__info {
      flex-direction: column !important;
      gap: 14px !important;
      margin-top: 22px !important;
      padding-top: 18px !important;
    }
  }
</style>
<section
  id="m-section--{{ section.id }}"
  data-section-type="contact-page"
  data-section-id="{{ section.id }}"
  class="m-section m-contact-form"
>
  <div class="{{ container }} m-section-py">
    <div class="m-row{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-contact-form__main{% if section.blocks.size > 0 %} xl:m:w-8/12 m:w-full{% else %} m-contact-form__main--full xl:m:w-6/12 m:w-full{% endif %}">
        {% liquid
          assign is_ar = false
          if request.locale.iso_code contains 'ar' or localization.language.iso_code contains 'ar'
            assign is_ar = true
          endif

          assign form_title = st.title
          assign form_desc = st.description
          if is_ar
            if form_title contains 'hear from you' or form_title contains 'Get in touch' or form_title contains 'تواصل'
              assign form_title = 'يسعدنا دائماً تواصلكِ معنا'
            endif
            if form_desc contains 'For questions about your order' or form_desc contains 'استفسارات'
              assign form_desc = '<p>لأي استفسارات حول طلبكِ، أو مجموعاتنا، أو المقاسات، يُسعدنا تواصلكِ معنا وسيقوم فريقنا بمساعدتكِ بكل سرور.</p>'
            endif
          endif
        %}
        {%- if form_title != blank -%}
          <h3 class="m-contact-form__heading {{ st.heading_size | default: 'h4' }}">{{ form_title }}</h3>
        {%- endif -%}
        {%- if form_desc != blank -%}
          <div class="m-contact-form__description rte">{{ form_desc }}</div>
        {%- endif -%}
        {%- form 'contact' -%}
          {%- capture success_message -%}
            {{ 'contact.form.post_success' | t }}
          {%- endcapture -%}
          {% render 'form__success', form: form, success_message: success_message %}
          {% render 'form__error', form: form %}
          <div class="m-contact-form__form-fields m:flex m:flex-wrap">
            {% if section.settings.show_name %}
              <div class="m-contact-form__name m:column m:w-full md:m:w-1/2">
                <input
                  type="text"
                  class="form-field form-field--input"
                  name="contact[name]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  id="inputName"
                  placeholder="{{ 'contact.form.name' | t }}"
                >
              </div>
            {% endif %}
            <div class="m-contact-form__email m:column m:w-full md:m:w-1/2">
              <input
                type="email"
                class="form-field form-field--input"
                name="contact[email]"
                required
                autocorrect="off"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                id="inputEmail"
                placeholder="{{ 'contact.form.email' | t }}"
              >
            </div>
            {% if section.settings.show_phone %}
              <div class="m-contact-form__phone m:column m:w-full">
                <input
                  type="tel"
                  class="form-field form-field--input"
                  name="contact[phone]"
                  autocorrect="off"
                  autocapitalize="off"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  id="inputPhone"
                  placeholder="{{ 'contact.form.phone' | t }}"
                >
              </div>
            {% endif %}
          </div>
          <div class="m-contact-form__message m:w-full">
            <textarea
              class="form-field form-field--input"
              name="contact[body]"
              rows="3"
              required
              placeholder="{{ 'contact.form.message' | t }}"
              id="textareaMessage"
            >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
          </div>
          {% if section.settings.show_signup_email %}
            <div class="m-contact-form__save">
              <label class="form-field--checkbox">
                <input type="checkbox" name="contact[saveInfo]">
                <span class="form-field--checkbox__label">{{ 'contact.form.save_infor_message' | t }}</span>
                <span class="form-field--checkbox__icon">
                  <svg
                    class="m-svg-icon--medium"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                    fill="none"
                    viewBox="0 0 20 20"
                  >
                    <path d="M18.5 1.5H1.5L1.5 18.5H18.5V1.5ZM1.5 0.5C0.947715 0.5 0.5 0.947715 0.5 1.5V18.5C0.5 19.0523 0.947715 19.5 1.5 19.5H18.5C19.0523 19.5 19.5 19.0523 19.5 18.5V1.5C19.5 0.947715 19.0523 0.5 18.5 0.5H1.5Z" fill-rule="evenodd" fill="currentColor"/>
                    <path d="M14.9975 6.09084C15.201 6.27746 15.2147 6.59375 15.0281 6.79728L8.91631 13.4627C8.82231 13.5652 8.68987 13.6239 8.55079 13.6247C8.41172 13.6256 8.27857 13.5684 8.18335 13.4671L4.99513 10.0731C4.80606 9.87179 4.81596 9.55536 5.01723 9.3663C5.21849 9.17723 5.53492 9.18713 5.72399 9.3884L8.54335 12.3897L14.291 6.12145C14.4776 5.91791 14.7939 5.90421 14.9975 6.09084Z" fill="currentColor"/>
                  </svg>
                </span>
              </label>
            </div>
          {% endif %}
          <div class="m-contact-form__submit-wrapper">
            <button type="submit" class="m-button m-button--primary m-contact-form__submit-btn">
              {{ 'contact.form.send' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
      {% if section.blocks.size > 0 %}
        <div class="m-contact-form__info m:flex m:flex-wrap m:w-full xl:m:w-4/12">
          {% for block in section.blocks %}
            <div class="m-info-box m:column m:w-full md:m:w-1/2 lg:m:w-3/12 xl:m:w-full" {{ block.shopify_attributes }}>
              {% liquid
                assign block_title = block.settings.title
                if is_ar and block_title != blank
                  if block_title contains 'Social Media' or block_title contains 'Social'
                    assign block_title = 'تابعينا'
                  elsif block_title == 'Address' or block_title contains 'العنوان'
                    assign block_title = 'العنوان'
                  endif
                endif
              %}
              {%- if block_title != blank -%}
                <h3 class="m-info-box__title {{ block.settings.heading_size | default: 'h5' }}">
                  {{ block_title }}
                </h3>
              {%- endif -%}
              {% case block.type %}
                {% when 'textblock' %}
                  <div class="m-info-box__content rte">
                    {%- assign raw_text = block.settings.content | strip_html | strip -%}
                    {%- if raw_text contains '@' and raw_text contains '.' -%}
                      {%- unless raw_text contains ' ' or block.settings.content contains '<svg' -%}
                        <a href="mailto:{{ raw_text }}" class="m-contact-email-link" aria-label="{{ raw_text }}">
                          <svg
                            class="m-svg-icon m-contact-email-icon"
                            fill="currentColor"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 512 512"
                            aria-hidden="true"
                          >
                            <path d="M464 64H48C21.49 64 0 85.49 0 112v288c0 26.51 21.49 48 48 48h416c26.51 0 48-21.49 48-48V112c0-26.51-21.49-48-48-48zm0 48v40.805c-22.422 18.259-58.168 46.651-134.587 106.49-16.841 13.247-50.201 45.072-73.413 44.701-23.208.375-56.579-31.459-73.413-44.701C106.18 199.465 70.425 171.067 48 152.805V112h416zM48 400V214.398c22.914 18.251 55.409 43.862 104.938 82.646 21.857 17.205 60.134 55.186 103.062 54.955 42.717.231 80.509-37.199 103.053-54.947 49.528-38.783 82.032-64.401 104.947-82.653V400H48z"/>
                          </svg>
                          <span>{{ raw_text }}</span>
                        </a>
                      {%- else -%}
                        {{ block.settings.content }}
                      {%- endunless -%}
                    {%- else -%}
                      {{ block.settings.content }}
                    {%- endif -%}
                  </div>
                {% else %}
                  {% render 'social-media-links' %}
              {% endcase %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "We would love to hear from you."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h4",
      "options": [
        {
          "label": "Heading xs",
          "value": "h6"
        },
        {
          "label": "Heading sm",
          "value": "h5"
        },
        {
          "label": "Heading md",
          "value": "h4"
        },
        {
          "label": "Heading lg",
          "value": "h3"
        },
        {
          "label": "Heading xl",
          "value": "h2"
        },
        {
          "label": "Heading 2xl",
          "value": "h1"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>If you’ve got great products your making or looking to work with us then drop us a line.</p>"
    },
    {
      "type": "header",
      "content": "Contact form"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show field name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show field phone number",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_signup_email",
      "label": "Show email sign up",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit global setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "textblock",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Block Title"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h5",
          "options": [
            {
              "label": "Heading xs",
              "value": "h6"
            },
