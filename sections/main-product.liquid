{{ 'product.css' | asset_url | stylesheet_tag }}
{{ 'luxury-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luxury-product.js' | asset_url }}" defer="defer"></script>
{% if section.settings.show_zoom_button %}
  {{ 'photoswipe.css' | asset_url | stylesheet_tag }}
  {{ 'component-photoswipe.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if product.quantity_price_breaks_configured? -%}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign container = section.settings.container
  assign layout = section.settings.layout
  if container == 'w-full'
    assign container = 'container-full'
  endif
  if layout == 'layout-7'
    assign container = 'container-full'
  endif
  assign first_3d_model = product.media | where: 'media_type', 'model' | first

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign enable_variant_group_img = false
  if section.settings.enable_variant_group_images and product.metafields['foxecom-bs-kit']['variant-images'].value.enable
    assign enable_variant_group_img = true
  endif

  assign disable_selected_variant_default = section.settings.disable_selected_variant_default

  if product.has_only_default_variant
    assign enable_variant_group_img = false
    assign disable_selected_variant_default = false
  endif
-%}

{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}
{%- capture variant_option_none_text -%}
  {%- render 'new-locale', key: 'products.product.choose_an_option' -%}
{%- endcapture -%}
<product-info
  id="MainProduct-{{ section.id }}"
  data-section-type="product-page"
  data-section-id="{{ section.id }}"
  data-layout="{{ layout }}"
  data-product-handle="{{ product.handle }}"
  data-url="{{ product.url }}"
  data-update-url="true"
  data-enable-history-state="{{ section.settings.enable_history_state }}"
  data-product-id="{{ product.id }}"
  data-container="{{ container }}"
  data-enable-variant-group-images="{{ enable_variant_group_img }}"
  data-disable-selected-variant-default="{{ disable_selected_variant_default }}"
  data-variant-option-none-text="{{ variant_option_none_text }}"
  data-show-featured-media="{{ section.settings.show_featured_media }}"
  class="m-main-product m-gradient m-color-{{ settings.default_color_scheme }} m:block"
>
  <div class="{{ container }}">
    {% liquid
      assign media_class = 'm:w-full md:m:w-1/2'
      assign info_class = 'm:w-full md:m:w-1/2'
      assign wrapper_class = 'm:flex m:flex-wrap'
      case layout
        when 'layout-2'
          assign media_class = 'm:w-full md:m:w-7/12'
          assign info_class = 'm:w-full md:m:w-5/12'
          assign column_gap = '70px'
        when 'layout-3'
          assign media_class = 'm:w-full md:m:w-7/12'
          assign info_class = 'm:w-full md:m:w-5/12'
          assign column_gap = '70px'
        when 'layout-5'
          assign media_class = 'm:w-full md:m:w-7/12'
          assign info_class = 'm:w-full md:m:w-5/12 '
          assign column_gap = '70px'
        when 'layout-7'
          assign media_class = 'm:w-full'
          if product.media.size == 1
            assign media_class = 'container-narrow'
          endif
          assign info_class = 'container-narrow md:m:text-center'
          assign wrapper_class = 'm:flex m:flex-wrap md:m:block m-product-media--layout-7'
        else
          assign column_gap = '50px'
      endcase
    %}
    {% liquid
      assign collection_url = product.collections.first.url | default: '/collections/all'
    %}
    <div
      class="m-main-product--wrapper m-luxury-3col-container"
    >
      <product-recently-viewed data-product-id="{{ product.id }}" class="m:hidden"></product-recently-viewed>
      
      <!-- COLUMN 1: Thumbnails (30%) & Back Link -->
      <div class="m-luxury-col-thumb">
        <div class="m-luxury-thumb-inner">
          <a href="{{ collection_url }}" class="m-luxury-back-link" aria-label="Back to All">
            <span class="m-luxury-back-arrow">&lt;</span>
            <span class="m-luxury-back-text">All</span>
          </a>

          {% if product.media.size > 1 %}
            <div class="m-luxury-thumbnails-container">
              <button type="button" class="m-luxury-thumb-arrow m-luxury-thumb-prev" aria-label="Previous thumbnails">
                <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 5 5 1 1 5"></polyline>
                </svg>
              </button>

              <div class="m-luxury-thumbnails-wrap" id="LuxuryThumbnails-{{ section.id }}">
                <ul class="m-luxury-thumbnails-list" role="tablist">
                  {% for media in product.media %}
                    <li class="m-luxury-thumb-item {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}" role="tab">
                      <div class="m-luxury-thumb-box">
                        <img src="{{ media.preview_image | image_url: width: 220, height: 300, crop: 'center' }}" alt="{{ media.alt | default: product.title | escape }}" class="m-luxury-thumb-img" loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}">
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              </div>

              <button type="button" class="m-luxury-thumb-arrow m-luxury-thumb-next" aria-label="Next thumbnails">
                <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="1 1 5 5 9 1"></polyline>
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- COLUMN 2: Product Main Hero Image (40%) -->
      <div class="m-luxury-col-main">
        <div class="m-luxury-slider-viewport" id="LuxurySliderViewport-{{ section.id }}" data-draggable="true">
          <div class="m-luxury-slider-track" id="LuxurySliderTrack-{{ section.id }}">
            {% for media in product.media %}
              <div class="m-luxury-slide-item {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
                <div class="m-luxury-slide-inner">
                  <img
                    src="{{ media | image_url: width: 1400 }}"
                    srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    alt="{{ media.alt | default: product.title | escape }}"
                    class="m-luxury-main-img"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    draggable="false"
                  >
                </div>
              </div>
            {% endfor %}
          </div>

          {% if product.media.size > 1 %}
            <button type="button" class="m-luxury-nav-btn m-luxury-nav-prev" id="LuxuryNavPrev-{{ section.id }}" aria-label="Previous image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <button type="button" class="m-luxury-nav-btn m-luxury-nav-next" id="LuxuryNavNext-{{ section.id }}" aria-label="Next image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

            <div class="m-luxury-progress-bar-wrap">
              <div class="m-luxury-progress-bar-track">
                <div class="m-luxury-progress-bar-fill" id="LuxuryProgressFill-{{ section.id }}" style="width: {{ 100.0 | divided_by: product.media.size }}%;"></div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- COLUMN 3: Product Information & Size Guide Drawer (30%) -->
      <div class="m-luxury-col-info{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        <div class="m-luxury-product-details-view is-visible">
          <div class="m-product-info--wrapper m:text-color-body">
            {% render 'main-product-blocks', section: section, product: product %}
          </div>
        </div>

        <!-- Slide-in Size Guide Panel -->
        {% render 'luxury-size-guide-drawer', section: section, product: product %}
      </div>
    </div>
  </div>

  {% if section.settings.use_sticky_atc or section.settings.use_sticky_atc_on_mobile %}
    {% render 'sticky-atc', section: section, product: product, first_3d_model: first_3d_model %}
  {% endif %}

  {%- if enable_variant_group_img -%}
    <script id="variantGroup" type="application/json">
      {{ product.metafields.foxecom-bs-kit.variant-images.value | json }}
    </script>
  {%- endif -%}
</product-info>
{%- if section.settings.show_zoom_button -%}
  <script src="{{ 'photoswipe.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% if product.media.size > 0 %}
  <script src="{{ 'product-media.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- if first_3d_model -%}
  <script type="application/json" id="ModelJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
  <script src="{{ 'product-model.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if product.options_with_values.size > 0 -%}
  <script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

{%- render 'product-data' -%}

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Watch tutorial](https://foxecom.link/olxmn9) or [read How-to](https://foxecom.link/QlS05K)"
    },
    {
      "type": "paragraph",
      "content": "Need more advanced customization? Use [Teeinblue Product Personalizer](https://teeinblue.com/install/teeinblue?ref=foxecom) app"
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "layout-6",
      "options": [
        {
          "value": "layout-4",
          "label": "Standard"
        },
        {
          "value": "layout-1",
          "label": "Grid 1 column"
        },
        {
          "value": "layout-3",
          "label": "Grid 2 columns"
        },
        {
          "value": "layout-2",
          "label": "Grid mix"
        },
        {
          "value": "layout-5",
          "label": "Slider 2 columns"
        },
        {
          "value": "layout-6",
          "label": "Slider vertical"
        },
        {
          "value": "layout-7",
          "label": "Slider full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_atwl",
      "label": "Show Add to wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_history_state",
      "label": "Enable history state",
