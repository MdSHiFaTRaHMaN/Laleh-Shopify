          "id": "sale_badge_type",
          "default": "percentage",
          "options": [
            {
              "label": "Percentage",
              "value": "percentage"
            },
            {
              "label": "Text",
              "value": "text"
            },
            {
              "label": "Fixed amount",
              "value": "fixed_amount"
            }
          ]
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variants selector",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "[Watch tutorial](https://foxecom.link/bqhGMd) or [read How-to](https://foxecom.link/F7UNEx)"
        },
        {
          "type": "header",
          "content": "Size guide settings"
        },
        {
          "type": "text",
          "id": "size_title",
          "default": "Size",
          "label": "Size option title",
