          "type": "checkbox",
          "id": "show_collections",
          "label": "Show collections list",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show product vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_type",
