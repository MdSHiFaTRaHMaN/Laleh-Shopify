          "default": "<strong>{count_number}</strong> <strong>people</strong> are viewing this right now"
        },
        {
          "type": "text",
          "id": "live_views_range",
          "label": "Visitor count range",
          "default": "20-30"
        },
        {
          "type": "text",
          "id": "live_view_duration",
          "label": "Change count number every",
          "default": "10",
          "info": "Seconds"
        },
        {
          "type": "checkbox",
          "id": "live_view_icon_blinks",
          "label": "Visitor count icon blinks",
          "default": true
        }
      ]
    },
    {
      "type": "shipping",
      "name": "Shipping information",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Delivery times"
        },
        {
          "type": "checkbox",
          "id": "show_delivery_times",
          "label": "Show delivery estimation",
          "info": "How delivery times are generated?",
          "default": true
        },
        {
          "type": "text",
          "id": "deliver_text",
          "label": "Delivery text",
          "default": "Estimated Delivery:",
          "visible_if": "{{ block.settings.show_delivery_times == true }}"
        },
        {
          "type": "text",
          "id": "deliver_days",
          "label": "Deliver in:",
          "info": "days (+/- 2 days)",
          "default": "7",
          "visible_if": "{{ block.settings.show_delivery_times == true }}"
        },
        {
          "type": "text",
          "id": "date_format",
