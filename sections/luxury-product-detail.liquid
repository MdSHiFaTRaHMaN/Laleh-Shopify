{% comment %}
  Luxury 3-Column Product Detail Section
  Design matching Elie Saab Couture
  - Column 1: Thumbnails with vertical navigation & back link
  - Column 2: Main hero slider with drag/swipe, floating arrows & progress indicator
  - Column 3: Product info with international size selector, Size Guide, Add to Bag, Wishlist & smooth accordions
{% endcomment %}

{{ 'luxury-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luxury-product.js' | asset_url }}&v=1.0.3" defer="defer"></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign show_back_link = section.settings.show_back_link
  assign back_link_text = section.settings.back_link_text | default: 'All'
  assign back_link_url = collection.url | default: routes.all_products_collection_url
  if collection.title != blank and section.settings.use_collection_name
    assign back_link_text = collection.title
  endif

  assign color_option_index = -1
  assign size_option_index = -1
  for option in product.options_with_values
    assign downcased_name = option.name | downcase
    if downcased_name contains 'color' or downcased_name contains 'colour'
      assign color_option_index = forloop.index0
    elsif downcased_name contains 'size' or downcased_name contains 'taille' or downcased_name contains 'talla' or downcased_name contains 'größe'
      assign size_option_index = forloop.index0
    endif
  endfor
%}

<section
  id="LuxuryProduct-{{ section.id }}"
  class="m-luxury-product-section"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
>
  <div class="m-luxury-3col-container">
    <!--
      ==========================================================
      COLUMN 1: THUMBNAILS & BACK LINK (30%)
      ==========================================================
    -->
    <div class="m-luxury-col-thumb">
      <div class="m-luxury-thumb-inner">
        {% if show_back_link %}
          <a href="{{ back_link_url }}" class="m-luxury-back-link" aria-label="Back to {{ back_link_text }}">
            <img src="https://cdn.shopify.com/s/files/1/0919/0978/3882/files/left-chevron.png?v=1789101804" width="12">
            {% comment %} <span class="m-luxury-back-arrow">&lt;</span> {% endcomment %}
            <span class="m-luxury-back-text">{{ back_link_text }}</span>
          </a>
        {% endif %}

        {% if product.media.size > 1 %}
          <div class="m-luxury-thumbnails-container">
            <!-- Top Chevron -->
            <button type="button" class="m-luxury-thumb-arrow m-luxury-thumb-prev" aria-label="Scroll thumbnails up">
              <svg
                viewBox="0 0 10 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 5 5 1 1 5"></polyline>
              </svg>
            </button>

            <div class="m-luxury-thumbnails-wrap" id="LuxuryThumbnails-{{ section.id }}">
              <ul class="m-luxury-thumbnails-list" role="tablist">
                {% for media in product.media %}
                  <li
                    class="m-luxury-thumb-item{% if forloop.first %} is-active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    data-media-id="{{ media.id }}"
                    data-media-type="{{ media.media_type }}"
                    role="tab"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    tabindex="0"
                  >
                    <div class="m-luxury-thumb-box">
                      <img
                        src="{{ media.preview_image | default: media | image_url: width: 240, height: 320, crop: 'center' }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        class="m-luxury-thumb-img"
                        loading="lazy"
                        width="86"
                        height="116"
                      >
                      {% if media.media_type contains 'video' %}
                        <span class="m-luxury-thumb-badge" aria-label="Video">
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                            <path d="M8 5v14l11-7z"/>
                          </svg>
                        </span>
                      {% endif %}
                    </div>
                  </li>
                {% endfor %}
              </ul>
            </div>

            <!-- Bottom Chevron -->
            <button type="button" class="m-luxury-thumb-arrow m-luxury-thumb-next" aria-label="Scroll thumbnails down">
              <svg
                viewBox="0 0 10 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="1 1 5 5 9 1"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    </div>

    <!--
      ==========================================================
      COLUMN 2: MAIN HERO IMAGE SLIDER (40%)
      ==========================================================
    -->
    <div class="m-luxury-col-main">
      <div class="m-luxury-media-gallery" id="LuxuryGallery-{{ section.id }}">
        <div class="m-luxury-slider-viewport" id="LuxurySliderViewport-{{ section.id }}" data-draggable="true">
          <!-- Slider Track -->
          <div class="m-luxury-slider-track" id="LuxurySliderTrack-{{ section.id }}">
            {% if product.media.size > 0 %}
              {% for media in product.media %}
                <div
                  class="m-luxury-slide-item{% if forloop.first %} is-active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-media-id="{{ media.id }}"
                  data-media-type="{{ media.media_type }}"
                >
                  <div class="m-luxury-slide-inner">
                    {% case media.media_type %}
                      {% when 'image' %}
                        <img
                          src="{{ media | image_url: width: 1400 }}"
                          srcset="
                            {{ media | image_url: width: 600 }} 600w,
                            {{ media | image_url: width: 900 }} 900w,
                            {{ media | image_url: width: 1200 }} 1200w,
                            {{ media | image_url: width: 1600 }} 1600w
                          "
                          sizes="(min-width: 1024px) 45vw, 100vw"
                          alt="{{ media.alt | default: product.title | escape }}"
                          class="m-luxury-main-img"
                          {% if forloop.first %}
                            fetchpriority="high"
                          {% else %}
                            loading="lazy"
                          {% endif %}
                          width="{{ media.width | default: 640 }}"
                          height="{{ media.height | default: 880 }}"
                          draggable="false"
                        >
                      {% when 'video' %}
                        <div class="m-luxury-video-wrapper" data-media-type="video">
                          {% assign video_poster = media.preview_image | image_url: width: 1400 %}
                          {{
                            media
                            | video_tag:
                              controls: false,
                              autoplay: true,
                              loop: true,
                              muted: true,
                              playsinline: true,
                              preload: 'auto',
                              poster: video_poster,
                              image_size: '1400x',
                              class: 'm-luxury-main-video'
                          }}
                        </div>
                      {% when 'external_video' %}
                        <div class="m-luxury-video-wrapper" data-media-type="external_video">
                          {% liquid
                            assign video_class = 'm-luxury-main-video'
                            if media.host == 'youtube'
                              echo media | external_video_url: autoplay: 0, loop: 1, mute: 1, playlist: media.external_id, enablejsapi: 1 | external_video_tag: class: video_class, loading: 'lazy'
                            elsif media.host == 'vimeo'
                              echo media | external_video_url: autoplay: 0, loop: 1, muted: 1 | external_video_tag: class: video_class, loading: 'lazy'
                            else
                              echo media | external_video_tag: class: video_class, loading: 'lazy'
                            endif
                          %}
                        </div>
                      {% when 'model' %}
                        <div class="m-luxury-model-wrapper">
                          {{ media | model_viewer_tag: image_size: '1000x', reveal: 'interaction', toggleable: true }}
                        </div>
                      {% else %}
                        <img
                          src="{{ media | image_url: width: 1400 }}"
                          alt="{{ media.alt | default: product.title | escape }}"
                          class="m-luxury-main-img"
                          loading="lazy"
                          draggable="false"
                        >
                    {% endcase %}
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="m-luxury-slide-item is-active" data-index="0">
                <div class="m-luxury-slide-inner">
                  {{ 'product-1' | placeholder_svg_tag: 'm-luxury-main-img' }}
                </div>
              </div>
            {% endif %}
          </div>

          <!-- Floating Prev/Next Buttons (Visible if multiple images) -->
          {% if product.media.size > 1 %}
            <button type="button" class="m-luxury-nav-btn m-luxury-nav-prev" aria-label="Previous image">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button type="button" class="m-luxury-nav-btn m-luxury-nav-next" aria-label="Next image">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

            <!-- Bottom Progress Line Indicator -->
            <div class="m-luxury-progress-bar-wrap">
              <div class="m-luxury-progress-bar-track">
                <div
                  class="m-luxury-progress-bar-fill"
                  style="width: {{ 100.0 | divided_by: product.media.size }}%;"
                ></div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <!--
      ==========================================================
      COLUMN 3: PRODUCT INFORMATION & SIZE GUIDE (30%)
      ==========================================================
    -->
    <div class="m-luxury-col-info">
      <!-- View 1: Product Main Details -->
      <div class="m-luxury-product-details-view is-visible" id="m-luxury-product-details-view-{{ section.id }}">
        <!-- Product Title -->
        <h1 class="m-luxury-product-title">{{ product.title }}</h1>

        <!-- Product Price -->
        <div class="m-luxury-product-price-row" id="Price-{{ section.id }}">
          {% liquid
            if settings.currency_code_enabled
              assign raw_price = current_variant.price | money_with_currency
              assign raw_compare = current_variant.compare_at_price | money_with_currency
            else
              assign raw_price = current_variant.price | money
              assign raw_compare = current_variant.compare_at_price | money
            endif
            assign v_price = raw_price | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip
            assign v_compare = raw_compare | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip
          %}
          {% if current_variant.compare_at_price > current_variant.price %}
            <span
              class="m-luxury-product-price m-luxury-product-price--sale"
              data-base-price="{{ current_variant.price }}"
              data-price="{{ current_variant.price }}"
              data-amount="{{ current_variant.price }}"
            >
              {{ v_price }}
            </span>
            <s
              class="m-luxury-product-price--compare"
              data-base-price="{{ current_variant.compare_at_price }}"
              data-compare-price="{{ current_variant.compare_at_price }}"
              data-amount="{{ current_variant.compare_at_price }}"
              style="margin-left: 8px; color: #a1a1aa; font-size: 14px;"
            >
              {{ v_compare }}
            </s>
          {% else %}
            <span
              class="m-luxury-product-price"
              data-base-price="{{ current_variant.price }}"
              data-price="{{ current_variant.price }}"
              data-amount="{{ current_variant.price }}"
            >
              {{ v_price }}
            </span>
          {% endif %}
        </div>

        <!-- Color Option (if exists) -->
        {% if color_option_index >= 0 %}
          {% assign color_option = product.options_with_values[color_option_index] %}
          <div class="m-luxury-color-section">
            <span class="m-luxury-color-label">
              {{- color_option.name }}:
              <strong class="m-luxury-selected-color-name">{{ color_option.selected_value }}</strong></span
            >
            <div class="m-luxury-color-swatches-row">
              {% for value in color_option.values %}
                {% liquid
                  assign variant_for_color = null
                  for var in product.variants
                    if var.options[color_option_index] == value
                      assign variant_for_color = var
                      break
                    endif
                  endfor
                %}
                <button
                  type="button"
                  class="m-luxury-color-swatch-box{% if color_option.selected_value == value %} active{% endif %}"
                  data-option-index="{{ color_option_index }}"
                  data-value="{{ value | escape }}"
                  title="{{ value | escape }}"
                  aria-label="{{ value | escape }}"
                >
                  {% if variant_for_color.featured_image %}
                    <img
                      src="{{ variant_for_color.featured_image | image_url: width: 80, height: 80, crop: 'center' }}"
                      alt="{{ value | escape }}"
                      class="m-luxury-color-swatch-img"
                    >
                  {% else %}
                    <span
                      class="m-luxury-color-swatch-circle"
                      style="background-color: {{ value | downcase | remove: ' ' }};"
                    ></span>
                  {% endif %}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- Size Option -->
        {% if size_option_index >= 0 %}
          {% assign size_option = product.options_with_values[size_option_index] %}
          <div class="m-luxury-size-section">
            <div class="m-luxury-size-header-row">
              <span class="size-v-title">{{ 'products.product.select_size' | t | default: 'Select Size' }}</span>
              <button type="button" class="m-luxury-size-guide-trigger-btn" data-open-sizeguide>
                {{ 'products.product.size_guide' | t | default: 'Size guide' }}
              </button>
            </div>
            <!-- Size Buttons Grid -->
            <div
              class="m-luxury-sizes-grid"
              id="m-luxury-sizes-grid-{{ section.id }}"
              data-option-index="{{ size_option_index }}"
            >
              {% for value in size_option.values %}
                {% liquid
                  assign is_available = false
                  assign variant_for_size = null
                  for var in product.variants
                    if var.options[size_option_index] == value
                      assign variant_for_size = var
                      if var.available
                        assign is_available = true
                      endif
                      break
                    endif
                  endfor
                %}
                <button
                  type="button"
                  class="m-luxury-size-box{% if size_option.selected_value == value %} active{% endif %}{% unless is_available %} is-unavailable{% endunless %}"
                  data-value="{{ value | escape }}"
                  data-original-value="{{ value | escape }}"
                  data-variant-id="{{ variant_for_size.id }}"
                  data-available="{{ is_available }}"
                  data-price="{{ variant_for_size.price }}"
                  data-compare-price="{{ variant_for_size.compare_at_price }}"
                  {% unless is_available %}
                    title="{{ 'products.product.sold_out' | t | default: 'Out of Stock' }}"
                  {% endunless %}
                  aria-label="{{ value }}"
                >
                  {{ value }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% else %}
          {% comment %} Fallback Size Grid if product has custom size options {% endcomment %}
          {% if product.options.size > 0 and product.has_only_default_variant == false %}
            {% for option in product.options_with_values %}
              {% unless forloop.index0 == color_option_index %}
                <div class="m-luxury-sizes-grid" data-option-index="{{ forloop.index0 }}">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="m-luxury-size-box{% if option.selected_value == value %} active{% endif %}"
                      data-value="{{ value | escape }}"
                      data-original-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
                <div class="m-luxury-size-guide-trigger-row">
                  <button type="button" class="m-luxury-size-guide-trigger-btn" data-open-sizeguide>
                    {{ 'products.product.size_guide' | t | default: 'Size Guide' }}
                  </button>
                </div>
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endif %}

        <!-- Product Form & Action Buttons (Add to Bag & Wishlist) -->
        <product-form class="m-product-form m-product-form--main" data-product-id="{{ product.id }}">
          {%- form 'product',
            product,
            id: product_form_id,
            data-product-id: product.id,
            class: 'm-luxury-product-form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form',
            data-product-handle: product.handle
          -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <div class="m-product-form-message"></div>

            <div class="m-luxury-actions-group">
              <!-- Add to Bag Button -->
              <button
                type="submit"
                name="add"
                id="ProductSubmitButton-{{ section.id }}"
                class="m-add-to-cart m-luxury-add-to-bag-btn"
                data-atc-text="{{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}"
                data-soldout-text="{{ 'products.product.sold_out' | t | default: 'Out of Stock' }}"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <span class="m-add-to-cart--text">
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t | default: 'Out of Stock' }}
                  {%- endif -%}
                </span>
              </button>

              <!-- Native Theme Wishlist Button -->
              <button
                type="button"
                class="m-wishlist-button m-luxury-wishlist-btn in-prod-page"
                data-product-handle="{{ product.handle }}"
                aria-label="{{ 'products.product.add_to_wishlist' | t | default: 'Add to Wishlist' }}"
              >
                <span class="m-luxury-wishlist-icon m-luxury-wishlist-icon--default">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#18181b"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </span>
                <span class="m-luxury-wishlist-icon m-luxury-wishlist-icon--active">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="#e11d48"
                    stroke="#e11d48"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </span>
                <span
                  class="m-wishlist-button-text"
                  data-revert-text="{{ 'products.product.remove_from_wishlist' | t | default: 'Remove from Wishlist' }}"
                >
                  {{- 'products.product.add_to_wishlist' | t | default: 'Add to Wishlist' -}}
                </span>
              </button>
            </div>
          {%- endform -%}
        </product-form>

        <script>
          (function() {
            function updateSizeSelection(btn) {
              if (!btn) return;
              const grid = btn.closest('.m-luxury-sizes-grid');
              const section = btn.closest('.m-luxury-product-section') || document;
              if (grid) {
                grid.querySelectorAll('.m-luxury-size-box').forEach(function(b) {
                  b.classList.remove('active');
                });
              }
              btn.classList.add('active');

              const variantId = btn.getAttribute('data-variant-id');
              if (variantId) {
                const inputs = section.querySelectorAll('form[action*="/cart/add"] input[name="id"], .m-luxury-product-form input[name="id"], .m-product-form input[name="id"]');
                inputs.forEach(function(input) {
                  input.value = variantId;
                  input.dispatchEvent(new Event('change', { bubbles: true }));
                  input.dispatchEvent(new Event('input', { bubbles: true }));
                });

                try {
                  const url = new URL(window.location.href);
                  url.searchParams.set('variant', variantId);
                  window.history.replaceState({}, '', url.toString());
                } catch(e) {}
              }

              // Update Add to Bag button availability state
              const isAvailable = btn.getAttribute('data-available') !== 'false' && !btn.classList.contains('is-unavailable');
              const atcBtns = section.querySelectorAll('.m-luxury-add-to-bag-btn, [name="add"]');
              atcBtns.forEach(function(atc) {
                const atcText = atc.querySelector('.m-add-to-cart--text');
                if (isAvailable) {
                  atc.removeAttribute('disabled');
                  if (atcText) {
                    atcText.textContent = atc.getAttribute('data-atc-text') || 'Add to Bag';
                  }
                } else {
                  atc.setAttribute('disabled', 'disabled');
                  if (atcText) {
                    atcText.textContent = atc.getAttribute('data-soldout-text') || 'Out of Stock';
                  }
                }
              });
            }

            // Capture phase click handler on size boxes
            document.addEventListener('click', function(e) {
              const btn = e.target.closest('.m-luxury-size-box');
              if (btn) {
                updateSizeSelection(btn);
              }
            }, true);

            // Safety check before form submission: make sure input[name="id"] matches active size box
            document.addEventListener('submit', function(e) {
              const form = e.target.closest('form[action*="/cart/add"], .m-luxury-product-form');
              if (form) {
                const section = form.closest('.m-luxury-product-section') || document;
                const activeSizeBtn = section.querySelector('.m-luxury-sizes-grid .m-luxury-size-box.active');
                if (activeSizeBtn) {
                  const targetVarId = activeSizeBtn.getAttribute('data-variant-id');
                  if (targetVarId) {
                    let idInput = form.querySelector('input[name="id"]');
                    if (idInput && idInput.value !== targetVarId) {
                      idInput.value = targetVarId;
                    }
                  }
                }
              }
            }, true);
          })();
        </script>

        <!-- Collapsible Accordions (Smooth Open/Close) -->
        <div class="m-luxury-accordions">
          {% assign collapsible_tab_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'collapsible_tab' %}
              {% assign collapsible_tab_count = collapsible_tab_count | plus: 1 %}
              <div
                class="m-luxury-accordion-item{% if block.settings.default_open %} is-open{% endif %}"
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="m-luxury-accordion-header"
                  aria-expanded="{% if block.settings.default_open %}true{% else %}false{% endif %}"
                >
                  <span>{{ block.settings.heading | escape }}</span>
                  <svg
                    class="m-luxury-accordion-chevron"
                    viewBox="0 0 10 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="1 1 5 5 9 1"></polyline>
                  </svg>
                </button>
                <div class="m-luxury-accordion-body">
                  <div class="m-luxury-accordion-content rte">
                    {% assign heading_downcase = block.settings.heading | downcase %}
                    {% if heading_downcase contains 'deliver'
                      or heading_downcase contains 'return'
                      or heading_downcase contains 'shipping'
                    %}
                      <div class="m-luxury-accordion-truncated">
                        {% if block.settings.content != blank %}
                          {{ block.settings.content }}
                        {% elsif block.settings.liquid != blank %}
                          {{ block.settings.liquid }}
                        {% elsif block.settings.page != blank %}
                          {{ block.settings.page.content }}
                        {% else %}
                          <p>
                            We offer complimentary shipping on all online orders, with delivery typically completed
                            within 3-10 business days. You can anticipate a slight delay during December 2026.
                          </p>
                        {% endif %}
                      </div>
                      <button type="button" class="m-luxury-view-more-btn" data-open-moredetails="{{ block.id }}">
                        {{ 'general.accessibility.view_more' | t | default: 'View more' }}
                      </button>
                    {% elsif heading_downcase contains 'desc' %}
                      <div class="m-luxury-accordion-truncated">
                        {% if block.settings.liquid != blank %}
                          {{ block.settings.liquid }}
                        {% elsif block.settings.content != blank %}
                          {{ block.settings.content }}
                        {% elsif block.settings.page != blank %}
                          {{ block.settings.page.content }}
                        {% else %}
                          {{ product.description }}
                        {% endif %}
                      </div>
                      <button type="button" class="m-luxury-view-more-btn" data-open-moredetails="{{ block.id }}">
                        {{ 'general.accessibility.view_more' | t | default: 'View more' }}
                      </button>
                    {% elsif heading_downcase contains 'care' %}
                      {% capture care_content %}
                        {% if block.settings.content != blank %}
                          {{ block.settings.content }}
                        {% elsif block.settings.liquid != blank %}
                          {{ block.settings.liquid }}
                        {% elsif block.settings.page != blank %}
                          {{ block.settings.page.content }}
                        {% else %}
                          <p>
                            Specialist dry clean only. Do not tumble dry. Store in a breathable garment bag away from direct sunlight.
                          </p>
                        {% endif %}
                      {% endcapture %}
                      {% assign care_plain = care_content | strip_html | strip %}
                      {% assign care_word_count = care_plain | split: ' ' | size %}
                      {% if care_word_count > 45 %}
                        <div class="m-luxury-accordion-truncated">
                          {{ care_content }}
                        </div>
                        <button type="button" class="m-luxury-view-more-btn" data-open-moredetails="{{ block.id }}">
                          {{ 'general.accessibility.view_more' | t | default: 'View more' }}
                        </button>
                      {% else %}
                        <div>
                          {{ care_content }}
                        </div>
                      {% endif %}
                    {% else %}
                      {% capture other_content %}
                        {% if block.settings.liquid != blank %}
                          {{ block.settings.liquid }}
                        {% elsif block.settings.content != blank %}
                          {{ block.settings.content }}
                        {% elsif block.settings.page != blank %}
                          {{ block.settings.page.content }}
                        {% else %}
                          {{ product.description }}
                        {% endif %}
                      {% endcapture %}
                      {% assign other_plain = other_content | strip_html | strip %}
                      {% assign other_word_count = other_plain | split: ' ' | size %}
                      {% if other_word_count > 45 %}
                        <div class="m-luxury-accordion-truncated">
                          {{ other_content }}
                        </div>
                        <button type="button" class="m-luxury-view-more-btn" data-open-moredetails="{{ block.id }}">
                          {{ 'general.accessibility.view_more' | t | default: 'View more' }}
                        </button>
                      {% else %}
                        <div>
                          {{ other_content }}
                        </div>
                      {% endif %}
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {% if collapsible_tab_count == 0 %}
            <!-- Default Built-in Luxury Accordions -->
            <div class="m-luxury-accordion-item is-open">
              <button type="button" class="m-luxury-accordion-header" aria-expanded="true">
                <span>{{ 'products.product.description_title' | t | default: 'Description' }}</span>
                <svg
                  class="m-luxury-accordion-chevron"
                  viewBox="0 0 10 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="1 1 5 5 9 1"></polyline>
                </svg>
              </button>
              <div class="m-luxury-accordion-body">
                <div class="m-luxury-accordion-content rte">
                  <div class="m-luxury-accordion-truncated">
                    <p>
                      <strong>{{ product.title }}</strong>
                    </p>
                    <p>
                      {{ product.description | strip_html | truncatewords: 30, '' }}
                    </p>
                  </div>
                  <button type="button" class="m-luxury-view-more-btn" data-open-moredetails="desc">
                    {{ 'general.accessibility.view_more' | t | default: 'View more' }}
                  </button>
                </div>
              </div>
            </div>

            <div class="m-luxury-accordion-item">
              <button type="button" class="m-luxury-accordion-header" aria-expanded="false">
                <span>{{ 'products.product.delivery_returns_title' | t | default: 'Delivery & Returns' }}</span>
                <svg
                  class="m-luxury-accordion-chevron"
                  viewBox="0 0 10 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="1 1 5 5 9 1"></polyline>
                </svg>
              </button>
              <div class="m-luxury-accordion-body">
                <div class="m-luxury-accordion-content rte">
                  <div class="m-luxury-accordion-truncated">
                    <p>
                      {{
                        'cart.general.free_shipping_note'
                        | t
                        | default: 'We offer complimentary shipping on all orders.'
                      }}
                    </p>
                  </div>
                  <button type="button" class="m-luxury-view-more-btn" data-open-moredetails="delivery">
                    {{ 'general.accessibility.view_more' | t | default: 'View more' }}
                  </button>
                </div>
              </div>
            </div>

            <div class="m-luxury-accordion-item">
              <button type="button" class="m-luxury-accordion-header" aria-expanded="false">
                <span>{{ 'products.product.product_care_title' | t | default: 'Product Care' }}</span>
                <svg
                  class="m-luxury-accordion-chevron"
                  viewBox="0 0 10 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="1 1 5 5 9 1"></polyline>
                </svg>
              </button>
              <div class="m-luxury-accordion-body">
                <div class="m-luxury-accordion-content rte">
                  <p>
                    Specialist dry clean only. Do not tumble dry. Store in a breathable garment bag away from direct
                    sunlight.
                  </p>
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- View 2: Interactive Size Guide Drawer & Spec Table -->
      {% render 'luxury-size-guide-drawer', product: product %}

      <!-- View 3: Expanded Tabs Details Panel (Dynamically populated from Theme Editor Blocks) -->
      <div id="m-luxury-more-details-panel" class="m-luxury-more-details-panel" aria-hidden="true">
        <div class="m-luxury-more-inner">
          <!-- Top Tabs Navigation -->
          <div class="m-luxury-more-tabs-nav" role="tablist">
            {% if collapsible_tab_count > 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'collapsible_tab' %}
                  <button
                    type="button"
                    class="m-luxury-more-tab-btn{% if forloop.first %} active{% endif %}"
                    data-tab="{{ block.id }}"
                    data-tab-heading="{{ block.settings.heading | downcase | escape }}"
                    role="tab"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading | escape }}
                  </button>
                {% endif %}
              {% endfor %}
            {% else %}
              <button
                type="button"
                class="m-luxury-more-tab-btn active"
                data-tab="desc"
                role="tab"
                aria-selected="true"
              >
                {{ 'products.product.description_title' | t | default: 'Description' }}
              </button>
              <button type="button" class="m-luxury-more-tab-btn" data-tab="delivery" role="tab" aria-selected="false">
                {{ 'products.product.delivery_returns_title' | t | default: 'Delivery & Returns' }}
              </button>
              <button type="button" class="m-luxury-more-tab-btn" data-tab="care" role="tab" aria-selected="false">
                {{ 'products.product.product_care_title' | t | default: 'Product Care' }}
              </button>
            {% endif %}
          </div>

          <!-- Tabs Body -->
          <div class="m-luxury-more-tabs-body">
            {% if collapsible_tab_count > 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'collapsible_tab' %}
                  <div
                    class="m-luxury-more-tab-pane{% if forloop.first %} active{% endif %}"
                    id="m-tab-{{ block.id }}"
                    data-pane-heading="{{ block.settings.heading | downcase | escape }}"
                    role="tabpanel"
                  >
                    <div class="m-luxury-more-content rte">
                      {% if block.settings.liquid != blank %}
                        {{ block.settings.liquid }}
                      {% elsif block.settings.content != blank %}
                        {{ block.settings.content }}
                      {% elsif block.settings.page != blank %}
                        {{ block.settings.page.content }}
                      {% else %}
                        {{ product.description }}
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
              <!-- Fallback Tab 1: Description -->
              <div class="m-luxury-more-tab-pane active" id="m-tab-desc" role="tabpanel">
                <div class="m-luxury-more-content rte">
                  <p>
                    <strong>{{ product.title }}</strong>
                  </p>
                  <ul>
                    <li>43% Silk, 42% Polyester, 10% Polyamide, 5% Nylon</li>
                    <li>Product Code: {{ current_variant.sku | default: 'D1320EP26YA072' }}</li>
                    <li>Floral Embroidery</li>
                    <li>Sequin Embellishments</li>
                    <li>Draped Bodice</li>
                    <li>Slit on Right Leg</li>
                    <li>Floor-Length Hem</li>
                    <li>Silk Lining</li>
                  </ul>
                  {% if product.description != blank %}
                    <div class="m-luxury-full-desc-extra" style="margin-top: 14px;">
                      {{ product.description }}
                    </div>
                  {% endif %}
                </div>
              </div>

              <!-- Fallback Tab 2: Delivery & Returns -->
              <div class="m-luxury-more-tab-pane" id="m-tab-delivery" role="tabpanel">
                <div class="m-luxury-more-content rte">
                  <p>
                    We offer complimentary shipping on all online orders, with delivery typically completed within 3-10
                    business days. You can anticipate a slight delay during December 2026.
                  </p>
                  <p>
                    Please note that you may be subject to additional import duties, taxes, or fees depending on your
                    delivery destination. While shipping is free, these additional costs may apply and are the
                    responsibility of the customer.
                  </p>
                  <p>
                    We accept returns within 14 days of delivery. To request a return, please complete the Return Form
                    using your order number. Items must be returned in their original condition—unworn, unwashed, with
                    all tags and packaging intact.
                  </p>
                </div>
              </div>

              <!-- Fallback Tab 3: Product Care -->
              <div class="m-luxury-more-tab-pane" id="m-tab-care" role="tabpanel">
                <div class="m-luxury-more-content rte">
                  <p>Specialist dry clean only. Do not tumble dry.</p>
                  <p>Store in a breathable garment bag away from direct sunlight and moisture.</p>
                  <p>Handle delicate embroidery and sequin embellishments with care.</p>
                </div>
              </div>
            {% endif %}
          </div>

          <!-- Return to Product Footer CTA -->
          <div class="m-luxury-more-footer">
            <button type="button" class="m-luxury-more-return-btn" data-close-moredetails>
              <span>{{ 'products.product.return_to_product' | t | default: 'Return to product' }}</span>
              <span class="m-luxury-more-return-arrow">&gt;</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Variant JSON Map for JS Synchronizer -->
  <script type="application/json" id="LuxuryProductJson-{{ section.id }}">
    {{ product | json }}
  </script>
</section>

{% schema %}
{
  "name": "Luxury Product Detail",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show back navigation link",
      "default": true
    },
    {
      "type": "text",
      "id": "back_link_text",
      "label": "Back link label",
      "default": "All"
    },
    {
      "type": "checkbox",
      "id": "use_collection_name",
      "label": "Use current collection name if available",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collapsible_tab",
      "name": "Collapsible Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content"
        },
        {
          "type": "liquid",
          "id": "liquid",
          "label": "Custom Liquid (e.g. {{ product.description }})"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Tab content from page"
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Product Detail",
      "blocks": [
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Description",
            "liquid": "{{ product.description }}",
            "default_open": true
          }
        },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery & Returns",
            "content": "<p>Complimentary express worldwide delivery on all couture orders. Returns accepted within 14 days of receipt in original packaging with security seals intact.</p>",
            "default_open": false
          }
        },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Care",
            "content": "<p>Specialist dry clean only. Do not tumble dry. Store in a breathable garment bag away from direct sunlight.</p>",
            "default_open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
