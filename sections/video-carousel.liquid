<style>
  .vgc-section {
    width: 100%;
    padding: 20px 20px;
    box-sizing: border-box;
  }

  .vgc-inner {
    max-width: var(--vgc-max-width, 1600px);
    margin: 0 auto;
    width: 100%;
  }

  .vgc-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .vgc-heading {
    font-size: 34px;
    line-height: 1.2;
    margin: 0 0 8px;
  }

  .vgc-subheading {
    font-size: 1rem;
    opacity: 0.7;
    margin: 0;
  }

  .vgc-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .vgc-track {
    display: flex;
    gap: var(--vgc-gap, 20px);
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
    will-change: transform;
    -webkit-overflow-scrolling: touch;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .vgc-track.is-dragging {
    cursor: grabbing;
  }

  .vgc-track.is-dragging .vgc-item {
    pointer-events: none;
  }

  .vgc-item {
    position: relative;
    flex: 0 0 auto;
    width: calc((100% - (var(--vgc-gap, 20px) * 3)) / 4);
    aspect-ratio: 3 / 5;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .vgc-video-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--vgc-radius, 12px);
    overflow: hidden;
    background-color: #f4f4f4;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    isolation: isolate;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .vgc-poster-img,
  .vgc-poster-only,
  .vgc-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 1;
    pointer-events: none;
    background-color: #f4f4f4;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .vgc-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 2;
    background: transparent;
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.6s ease;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .vgc-item.is-playing .vgc-video {
    opacity: 1;
  }

  .vgc-placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .vgc-item.is-active .vgc-video {
    transform: scale(1.02);
  }

  .vgc-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.85);
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 3;
  }

  .vgc-video-wrap:hover .vgc-play-btn,
  .vgc-item.is-playing .vgc-play-btn {
    opacity: 0;
    pointer-events: none;
  }

  .vgc-item:not(.is-playing) .vgc-play-btn {
    opacity: 1;
    pointer-events: auto;
  }

  .vgc-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .vgc-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
    z-index: 3;
    pointer-events: none;
  }

  .vgc-caption-title {
    color: #fff;
    font-size: 0.85rem;
  }

  .vgc-controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  .vgc-nav {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .vgc-nav:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  /* ---------- Responsive breakpoints ---------- */
  @media screen and (max-width: 989px) {
    .vgc-item {
      width: calc((100% - (var(--vgc-gap, 20px) * 2)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .vgc-section {
      padding: 20px 16px 0px 16px;
    }

    .vgc-heading {
      font-size: 22px;
    }

    .vgc-item {
      width: calc((100% - (var(--vgc-gap, 20px) * (var(--vgc-mobile-cols, 2) - 1))) / var(--vgc-mobile-cols, 2));
      aspect-ratio: 3 / 4;
    }
  }

  @media screen and (max-width: 480px) {
    .vgc-item {
      width: calc((100% - (var(--vgc-gap, 20px) * (var(--vgc-mobile-cols, 2) - 1))) / var(--vgc-mobile-cols, 2));
    }
  }
</style>

<div
  class="vgc-section"
  id="vgc-{{ section.id }}"
  style="--vgc-max-width: {{ section.settings.max_width }}px; --vgc-gap: {{ section.settings.gap }}px; --vgc-radius: {{ section.settings.radius }}px; --vgc-mobile-cols: {{ section.settings.columns_mobile | default: '2' }};"
  data-autoplay-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
>
  <div class="vgc-inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="vgc-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="vgc-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vgc-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="vgc-carousel" data-vgc-carousel>
      <div class="vgc-track" data-vgc-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            {%- liquid
              assign poster_image = block.settings.poster
              if poster_image == blank and block.settings.video != blank
                assign poster_image = block.settings.video.preview_image
              endif
            -%}
            <div class="vgc-item" data-vgc-item data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="vgc-video-wrap">
                {%- if poster_image != blank -%}
                  <img
                    class="vgc-poster-img"
                    src="{{ poster_image | image_url: width: 900 }}"
                    alt="{{ block.settings.title | default: 'Video thumbnail' | escape }}"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    width="900"
                    height="1200"
                  >
                {%- endif -%}

                {%- if block.settings.video != blank -%}
                  <video
                    class="vgc-video"
                    data-vgc-video
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    preload="metadata"
                    {% if poster_image != blank %}
                      poster="{{ poster_image | image_url: width: 900 }}"
                    {% endif %}
                  >
                    {%- for source in block.settings.video.sources -%}
                      {%- if source.format == 'mp4' -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endif -%}
                    {%- endfor -%}
                  </video>
                {%- elsif poster_image == blank -%}
                  <div class="vgc-placeholder">{{ 'image' | placeholder_svg_tag: 'vgc-placeholder-svg' }}</div>
                {%- endif -%}

                <button class="vgc-play-btn" type="button" data-vgc-play-btn aria-label="Play video">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>

                {%- if block.settings.title != blank -%}
                  <div class="vgc-caption">
                    <span class="vgc-caption-title">{{ block.settings.title }}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="vgc-controls">
        <button class="vgc-nav vgc-prev" type="button" data-vgc-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="vgc-nav vgc-next" type="button" data-vgc-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  /**
   * Video Grid Carousel
   * - Seamless Infinite Loop with deterministic offsetLeft mapping
   * - Zero-glitch wrapping: user cannot perceive loop transitions
   * - Smooth single-card advance with navigation queueing
   * - Touch & cursor drag with live boundary shift and momentum snap
   * - Synchronized video playback across clone sets
   * - Bulletproof for iOS Safari, mobile web & power-saving modes
   */
  class VideoGridCarousel {
    constructor(root) {
      this.root = root;
      this.carousel = root.querySelector('[data-vgc-carousel]');
      this.track = root.querySelector('[data-vgc-track]');
      this.prevBtn = root.querySelector('[data-vgc-prev]');
      this.nextBtn = root.querySelector('[data-vgc-next]');

      if (!this.track || !this.track.children.length) return;

      this.autoplayInterval = parseInt(root.dataset.autoplayInterval, 10) || 5000;
      this.autoplayTimer = null;
      this.resumeTimer = null;
      this.isAnimating = false;
      this.queuedNav = 0;

      this.isDragging = false;
      this.startX = 0;
      this.startTranslate = 0;
      this.currentTranslate = 0;
      this.hasMoved = false;

      // Velocity tracking for momentum fling
      this.lastX = 0;
      this.lastT = 0;
      this.velocity = 0;

      // Luxury easing curve for buttery smooth transitions
      this.easeSnap = 'transform 0.65s cubic-bezier(0.16, 1, 0.3, 1)';

      this.setupInfiniteClones();
      this.blockIds = this.getUniqueBlockIds();

      this.bindDrag();
      this.bindNav();
      this.bindTransition();
      this.bindVideoInteractions();
      this.bindResize();

      // Double rAF ensures styles and layout are fully computed by browser
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          this.measure();
          // Start in the center set (Set 2: Originals)
          this.currentIndex = 2 * this.originalCount;
          this.goTo(this.currentIndex, false);
          this.playVisibleVideo();
          this.startAutoplay();
        });
      });

      window.addEventListener('load', () => {
        this.measure();
        if (this.currentIndex !== undefined && this.itemOffsets && this.itemOffsets[this.currentIndex] !== undefined) {
          this.goTo(this.currentIndex, false);
        }
      });
    }

    /* ---------- 5 Sets: [Set 0: -2, Set 1: -1, Set 2: 0 (Originals), Set 3: +1, Set 4: +2] ---------- */
    setupInfiniteClones() {
      const originals = Array.from(this.track.children);
      if (originals.length === 0) return;

      this.originalCount = originals.length;

      const cloneSet = () =>
        originals.map((item) => {
          const clone = item.cloneNode(true);
          clone.setAttribute('data-clone', 'true');
          return clone;
        });

      const before2 = cloneSet();
      const before1 = cloneSet();
      const after1 = cloneSet();
      const after2 = cloneSet();

      this.track.innerHTML = '';
      before2.forEach((node) => this.track.appendChild(node));
      before1.forEach((node) => this.track.appendChild(node));
      originals.forEach((node) => this.track.appendChild(node));
      after1.forEach((node) => this.track.appendChild(node));
      after2.forEach((node) => this.track.appendChild(node));

      // Ensure all images are eagerly cached to eliminate white flash
      this.track.querySelectorAll('img').forEach((img) => {
        img.loading = 'eager';
        img.setAttribute('loading', 'eager');
        img.setAttribute('fetchpriority', 'high');
        img.decoding = 'async';
      });

      // Re-initialize media attributes on all elements for cross-browser autoplay compliance
      this.track.querySelectorAll('video').forEach((v) => {
        v.muted = true;
        v.defaultMuted = true;
        v.playsInline = true;
        v.setAttribute('playsinline', 'true');
        v.setAttribute('webkit-playsinline', 'true');
        v.setAttribute('muted', '');
        try {
          v.load();
        } catch (e) {}
      });
    }

    getUniqueBlockIds() {
      const seen = [];
      Array.from(this.track.children).forEach((item) => {
        const id = item.dataset.blockId;
        if (id && !seen.includes(id)) seen.push(id);
      });
      return seen;
    }

    /* ---------- Exact DOM offset measurements for zero subpixel drift ---------- */
    measure() {
      const items = Array.from(this.track.children);
      if (!items.length) return;

      // Record exact offsetLeft for every card directly from browser layout engine
      this.itemOffsets = items.map((el) => el.offsetLeft);

      // Single card pitch and full original set width
      const centerStart = 2 * this.originalCount;
      const centerNext = centerStart + 1;
      const nextSetStart = 3 * this.originalCount;

      this.itemWidth =
        this.itemOffsets[centerNext] !== undefined
          ? this.itemOffsets[centerNext] - this.itemOffsets[centerStart]
          : items[0].getBoundingClientRect().width;

      this.setWidth =
        this.itemOffsets[nextSetStart] !== undefined && this.itemOffsets[centerStart] !== undefined
          ? this.itemOffsets[nextSetStart] - this.itemOffsets[centerStart]
          : this.itemWidth * this.originalCount;
    }

    bindResize() {
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          this.measure();
          if (this.currentIndex !== undefined && this.itemOffsets && this.itemOffsets[this.currentIndex] !== undefined) {
            this.goTo(this.currentIndex, false);
          }
        }, 150);
      });
    }

    /* ---------- Navigation (Prev / Next) with Queueing ---------- */
    bindNav() {
      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.slidePrev();
        });
      }

      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.slideNext();
        });
      }
    }

    slideNext() {
      this.pauseAutoplay();
      if (this.isAnimating) {
        this.queuedNav = 1;
        return;
      }
      this.goTo(this.currentIndex + 1, true);
    }

    slidePrev() {
      this.pauseAutoplay();
      if (this.isAnimating) {
        this.queuedNav = -1;
        return;
      }
      this.goTo(this.currentIndex - 1, true);
    }

    /* ---------- Card Movement & Seamless Normalization ---------- */
    goTo(targetIndex, animate = true) {
      if (!this.itemOffsets || !this.itemOffsets.length) return;

      // Safe clamp
      const clampedIndex = Math.max(0, Math.min(targetIndex, this.itemOffsets.length - 1));
      this.currentIndex = clampedIndex;
      const targetTranslate = -this.itemOffsets[this.currentIndex];
      this.currentTranslate = targetTranslate;

      if (animate) {
        this.isAnimating = true;
        this.track.style.transition = this.easeSnap;
      } else {
        this.track.style.transition = 'none';
      }

      this.track.style.transform = `translateX(${targetTranslate}px)`;

      if (!animate) {
        this.isAnimating = false;
        this.normalizeBounds();
      }
    }

    bindTransition() {
      this.track.addEventListener('transitionend', (e) => {
        // STRICT FILTER: Ignore bubbling transitions from videos, play buttons, captions, etc.
        if (e.target !== this.track || e.propertyName !== 'transform') return;

        this.isAnimating = false;

        // Perform instantaneous invisible position normalization if we landed in a clone set
        this.normalizeBounds();

        // Process queued user clicks without jarring resets
        if (this.queuedNav !== 0) {
          const dir = this.queuedNav;
          this.queuedNav = 0;
          this.goTo(this.currentIndex + dir, true);
        } else {
          this.scheduleAutoplayResume(1500);
        }
      });
    }

    /**
     * Seamlessly wrap index back to middle set (Set 2) in 0ms without the user ever noticing.
     * Clone cards in Set 3 are pixel-identical to original cards in Set 2.
     */
    normalizeBounds() {
      if (!this.originalCount || !this.itemOffsets) return;

      const centerMin = 2 * this.originalCount;
      const centerMax = 3 * this.originalCount - 1;

      if (this.currentIndex > centerMax || this.currentIndex < centerMin) {
        const oldIndex = this.currentIndex;
        let newIndex = this.currentIndex;

        while (newIndex > centerMax) {
          newIndex -= this.originalCount;
        }
        while (newIndex < centerMin) {
          newIndex += this.originalCount;
        }

        if (newIndex !== oldIndex && this.itemOffsets[newIndex] !== undefined) {
          // Sync any active video from the clone card to the target card so video playback doesn't reset
          this.syncVideoState(oldIndex, newIndex);

          this.currentIndex = newIndex;
          this.currentTranslate = -this.itemOffsets[newIndex];
          this.track.style.transition = 'none';
          this.track.style.transform = `translateX(${this.currentTranslate}px)`;

          // Force reflow to immediately commit the transform before any subsequent transition
          void this.track.offsetHeight;
        }
      }
    }

    syncVideoState(fromIndex, toIndex) {
      const fromItem = this.track.children[fromIndex];
      const toItem = this.track.children[toIndex];
      if (!fromItem || !toItem) return;

      const fromVideo = fromItem.querySelector('[data-vgc-video]');
      const toVideo = toItem.querySelector('[data-vgc-video]');
      if (!fromVideo || !toVideo) return;

      if (!fromVideo.paused || fromItem.classList.contains('is-playing')) {
        try {
          toVideo.currentTime = fromVideo.currentTime;
          toVideo.muted = fromVideo.muted;
          const p = toVideo.play();
          if (p !== undefined) {
            p.then(() => {
              toItem.classList.add('is-playing', 'is-active');
              fromVideo.pause();
              fromItem.classList.remove('is-playing', 'is-active');
            }).catch(() => {});
          }
        } catch (err) {}
      }
    }

    /* ---------- Drag & Swipe with Continuous Momentum ---------- */
    bindDrag() {
      const track = this.track;

      const onDown = (e) => {
        // Only trigger on primary mouse button or touch
        if (e.button !== undefined && e.button !== 0) return;

        this.isDragging = true;
        this.hasMoved = false;
        this.startX = this.getClientX(e);
        this.lastX = this.startX;
        this.lastT = performance.now();
        this.velocity = 0;

        // If dragging mid-flight, immediately freeze at current visual transform
        if (this.isAnimating) {
          const matrix = window.getComputedStyle(track).transform;
          if (matrix && matrix !== 'none') {
            const values = matrix.split('(')[1].split(')')[0].split(',');
            const currentX = parseFloat(values[4]);
            if (!isNaN(currentX)) {
              this.currentTranslate = currentX;
            }
          }
          this.isAnimating = false;
          this.queuedNav = 0;
        }

        this.startTranslate = this.currentTranslate;
        track.style.transition = 'none';
        track.classList.add('is-dragging');
        this.pauseAutoplay();
      };

      const onMove = (e) => {
        if (!this.isDragging) return;
        const x = this.getClientX(e);
        const now = performance.now();
        const dt = Math.max(now - this.lastT, 1);

        const delta = x - this.startX;
        if (Math.abs(delta) > 4) this.hasMoved = true;

        // Smooth velocity calculation (px/ms)
        const instVelocity = (x - this.lastX) / dt;
        this.velocity = this.velocity * 0.65 + instVelocity * 0.35;

        this.lastX = x;
        this.lastT = now;

        let nextTranslate = this.startTranslate + delta;

        // Live continuous buffer wrap during massive multi-screen drags
        if (this.setWidth > 0) {
          const minBound = -3.5 * this.setWidth;
          const maxBound = -0.5 * this.setWidth;
          if (nextTranslate < minBound) {
            this.startTranslate += this.setWidth;
            nextTranslate += this.setWidth;
          } else if (nextTranslate > maxBound) {
            this.startTranslate -= this.setWidth;
            nextTranslate -= this.setWidth;
          }
        }

        this.currentTranslate = nextTranslate;
        track.style.transform = `translateX(${nextTranslate}px)`;
      };

      const onUp = () => {
        if (!this.isDragging) return;
        this.isDragging = false;
        track.classList.remove('is-dragging');

        if (!this.hasMoved) {
          this.scheduleAutoplayResume(800);
          return;
        }

        this.applyMomentumAndSnap();
      };

      track.addEventListener('pointerdown', onDown);
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);

      // Prevent accidental link/video triggers after a drag gesture
      track.addEventListener(
        'click',
        (e) => {
          if (this.hasMoved) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );
    }

    getClientX(e) {
      return e.touches && e.touches.length ? e.touches[0].clientX : e.clientX;
    }

    applyMomentumAndSnap() {
      const MAX_VELOCITY = 1.6;
      const MOMENTUM_MULTIPLIER = 140;
      const v = Math.max(Math.min(this.velocity, MAX_VELOCITY), -MAX_VELOCITY);
      const projected = this.currentTranslate + v * MOMENTUM_MULTIPLIER;

      // Find the card whose offset aligns closest to the projected release position
      let closestIndex = this.currentIndex;
      let minDiff = Infinity;

      if (this.itemOffsets && this.itemOffsets.length) {
        for (let i = 0; i < this.itemOffsets.length; i++) {
          const diff = Math.abs(-this.itemOffsets[i] - projected);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = i;
          }
        }
        // Guardrail: Never allow momentum fling to pull empty white space into view
        const visibleCards = Math.ceil((this.carousel ? this.carousel.clientWidth : 1000) / (this.itemWidth || 1)) || 4;
        const maxSafeIndex = Math.max(0, this.itemOffsets.length - visibleCards);
        closestIndex = Math.max(0, Math.min(closestIndex, maxSafeIndex));
      }

      this.goTo(closestIndex, true);
    }

    /* ---------- Video Interactions & Single Audio Policy ---------- */
    bindVideoInteractions() {
      Array.from(this.track.children).forEach((item, index) => {
        const video = item.querySelector('[data-vgc-video]');
        const playBtn = item.querySelector('[data-vgc-play-btn]');
        const blockId = item.dataset.blockId;

        const handleUserPlay = (e) => {
          if (this.hasMoved) return;
          this.pauseAutoplay();

          const isUserClick = e && (e.type === 'click' || e.type === 'pointerup');
          this.playSingleVideo(item, isUserClick);
        };

        if (video) {
          video.addEventListener('playing', () => {
            item.classList.add('is-playing');
          });
          video.addEventListener('pause', () => {
            item.classList.remove('is-playing');
          });
          video.addEventListener('ended', () => {
            item.classList.remove('is-playing');
            // If the video naturally ended, smoothly advance to the next card
            if (item.dataset.clone !== 'true') {
              this.slideNext();
            }
          });
        }

        item.addEventListener('mouseenter', handleUserPlay);
        item.addEventListener('click', handleUserPlay);

        if (playBtn) {
          playBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            handleUserPlay(e);
          });
        }

        item.addEventListener('mouseleave', () => {
          this.scheduleAutoplayResume(1500);
        });
      });
    }

    playSingleVideo(activeItem, userInitiated = false) {
      // Pause all other videos across all clones to prevent audio overlap and CPU/GPU strain
      Array.from(this.track.children).forEach((item) => {
        if (item !== activeItem) {
          item.classList.remove('is-active', 'is-playing');
          const v = item.querySelector('[data-vgc-video]');
          if (v && !v.paused) {
            v.pause();
          }
        }
      });

      activeItem.classList.add('is-active');
      const targetVideo = activeItem.querySelector('[data-vgc-video]');
      if (targetVideo) {
        targetVideo.muted = !userInitiated;
        const playPromise = targetVideo.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => {
              activeItem.classList.add('is-playing');
            })
            .catch(() => {
              activeItem.classList.remove('is-playing');
            });
        }
      }
    }

    playVisibleVideo() {
      // Automatically activate the video on the currently visible leftmost card
      const currentItem = this.track.children[this.currentIndex];
      if (currentItem) {
        this.playSingleVideo(currentItem, false);
      }
    }

    /* ---------- Continuous Smooth Autoplay ---------- */
    startAutoplay() {
      if (!this.autoplayInterval || this.autoplayInterval <= 0) return;
      this.clearTimers();
      this.autoplayTimer = setInterval(() => {
        if (!this.isDragging) {
          this.slideNext();
        }
      }, this.autoplayInterval);
    }

    pauseAutoplay() {
      this.clearTimers();
    }

    scheduleAutoplayResume(delay = 1500) {
      if (!this.autoplayInterval || this.autoplayInterval <= 0) return;
      this.clearTimers();
      this.resumeTimer = setTimeout(() => {
        this.startAutoplay();
      }, delay);
    }

    clearTimers() {
      if (this.autoplayTimer) clearInterval(this.autoplayTimer);
      if (this.resumeTimer) clearTimeout(this.resumeTimer);
      this.autoplayTimer = null;
      this.resumeTimer = null;
    }
  }

  function initVideoGridCarousels() {
    document.querySelectorAll('.vgc-section').forEach((root) => {
      if (root.dataset.vgcInit) return;
      root.dataset.vgcInit = 'true';
      new VideoGridCarousel(root);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoGridCarousels);
  } else {
    initVideoGridCarousels();
  }

  document.addEventListener('shopify:section:load', (e) => {
    const root = e.target.querySelector('.vgc-section');
    if (root) {
      root.dataset.vgcInit = '';
      initVideoGridCarousels();
    }
  });
</script>

