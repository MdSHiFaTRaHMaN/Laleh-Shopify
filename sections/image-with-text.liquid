{{ 'image-with-text.css' | asset_url | stylesheet_tag }}

<script src="{{ 'image-layer.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign image_animation = section.settings.image_animation

  assign heading_size = section.settings.text_size | replace: 'small', 'h3' | replace: 'medium', 'h2' | replace: 'large', 'h1'
  assign subtext_size = 'h6'
  if heading_size == 'large' or heading_size == 'h1'
    assign subtext_size = 'h5'
  endif

  assign image_wrapper_class = 'm-image-with-text__image-wrapper' | append: ' m-image-with-text--' | append: section.settings.layout
  if section.settings.hover_effect
    assign image_wrapper_class = image_wrapper_class | append: ' m-scroll-trigger animate--' | append: animation_effect
  endif

  if section.settings.image_2 != blank
    assign image_wrapper_class = image_wrapper_class | append: ' m-image-with-text--multiple'
    if section.settings.image_overlap
      assign image_wrapper_class = image_wrapper_class | append: ' m-image-with-text--layer'
    endif
  endif

  if section.settings.show_image_reverse
    assign image_wrapper_class = image_wrapper_class | append: ' m-image-with-text--reverse'
  endif

  if image_animation == 'move-up-down'
    assign image_wrapper_class = image_wrapper_class | append: ' m-image-with-text--move-up-down'
  endif
%}

{%- capture section_classes -%}
m-section m-image-with-text {{ section.settings.custom_class }} m-section-{{ section.id }} m-gradient m-color-{{ section.settings.color_scheme }}
{%- endcapture -%}

{%- style -%}
  .m-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --column-gap: {{ section.settings.item_gap }}px;
    --row-gap: {{ section.settings.item_gap | divided_by: 2 }}px;
    --column-gap-mobile: {{ section.settings.item_gap_mobile }}px;
    --row-gap-mobile: {{ section.settings.item_gap_mobile }}px;

    background-color: {{ section.settings.background_color }};
  }
{%- endstyle -%}

<section id="m-section-{{ section.id }}" class="{{ section_classes }}">
  <div class="{{ container }} m-section-my m-section-py">
    {% render 'index-section-header', section_settings: section.settings %}

    <div class="m-image-with-text__inner m:flex m:flex-wrap{% if section.settings.layout == 'right' %} m:flex-row-reverse{% endif %}">
      <div
        class="m-image-with-text__image m:column m:w-full md:m:w-1/2 lg:m:w-{{ section.settings.image_column_size }}/12{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
        {% if animated %}
          data-cascade
          style="--animation-order: 1;"
        {% endif %}
      >
        <m-image-layer
          class="{{ image_wrapper_class }}"
          {% if image_animation == 'parallax' and section.settings.image_overlap %}
            data-enable-parallax="true"
          {% endif %}
          {% if section.settings.image_2 != 'blank' %}
            style="--offset-top: {{ section.settings.second_image_offset_top }}%"
          {% endif %}
        >
          <div class="m-image-with-text__image-first{% if section.settings.hover_effect %} m-hover-box m-hover-box--scale-up{% endif %} m:blocks-radius">
            {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
            {% if section.settings.image != blank %}
              {% render 'responsive-image', image: section.settings.image, image_class: 'm:w-full m:h-full' %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full m:object-cover' }}
            {% endif %}
            {% if section.settings.link != blank %}</a>{% endif %}
          </div>
          {% if section.settings.image_2 != blank %}
            <div class="m-image-with-text__image-second{% if section.settings.hover_effect %} m-hover-box m-hover-box--scale-up{% endif %} m:blocks-radius">
              {% if section.settings.link_2 != blank %}<a href="{{ section.settings.link_2 }}">{% endif %}
              {% render 'responsive-image', image: section.settings.image_2, image_class: 'm:w-full m:h-full' %}
              {% if section.settings.link_2 != blank %}</a>{% endif %}
            </div>
          {% endif %}
        </m-image-layer>
      </div>
      {% liquid
        assign is_ar = false
        if request.locale.iso_code contains 'ar' or localization.language.iso_code contains 'ar'
          assign is_ar = true
        endif

        assign display_sub_title = section.settings.sub_title
        assign display_title = section.settings.title
        assign display_text = section.settings.text
        assign display_button_label = section.settings.button_label

        if is_ar
          assign title_clean = display_title | strip | upcase
          if title_clean == 'THE STORY' or title_clean == 'القصة' or display_text contains 'Middle Eastern woman' or display_text contains 'سويسرا'
            if display_text contains 'Growing between two cultures' or display_text contains 'ثقافتين'
              assign display_title = 'قصتنا'
              assign display_text = '<p>تأسست دار LALEH برؤية سيدة من الشرق الأوسط نشأت في سويسرا، لتجسد تلاقي الأناقة الخالدة والأنوثة الراقية مع لمسة عصرية متجددة.</p><p><br/>ألهمها العيش بين ثقافتين تقديراً عميقاً لتنوع مفاهيم الأناقة والجمال. ومن هنا انطلقت LALEH، بشغف صياغة تلك الرؤية في تصاميم تنبض بالرقي، وتعكس حضوراً واثقاً وأنوثة متفردة.</p>'
            elsif display_title contains 'Born from two worlds' or title_clean contains 'عالمين' or display_sub_title contains 'ABOUT US' or display_sub_title contains 'من نحن'
              assign display_sub_title = 'عن الدار'
              assign display_title = 'ولدت من تلاقي عالمين، وصيغت برؤية واحدة.'
              assign display_text = '<p>تأسست دار LALEH برؤية سيدة من الشرق الأوسط نشأت في سويسرا، لتجسد تلاقي الأناقة الخالدة والأنوثة الراقية مع رؤية عصرية متجددة.</p>'
              if display_button_label != blank
                assign display_button_label = 'اكتشفي قصتنا'
              endif
            endif
          elsif title_clean == 'WHY LALEH' or title_clean contains 'لماذا لاله' or title_clean contains 'لماذا LALEH' or display_title contains 'لماذا' or display_text contains 'considered, refined and effortless' or display_text contains 'بفكرة بسيطة' or display_text contains 'ابتكار قطع' or display_text contains 'مدروسة وراقية'
            assign display_title = 'لماذا LALEH'
            assign display_text = '<p>انطلقت LALEH برؤية واضحة: إبداع تصاميم مدروسة وراقية، تمنحكِ حضوراً آسراً وأناقة تنساب دون عناء.<br/></p><p><br/>يُصاغ كل تصميم بعناية فائقة تراعي توازن الأبعاد ودقة التفاصيل وانسيابية القصّة، لنمنحكِ قطعاً تتسم بحضور استثنائي وتألق يدوم عبر الزمن.</p>'
          elsif title_clean == 'THE LALEH WOMAN' or title_clean == 'امرأة لاله' or title_clean == 'امرأة LALEH' or display_title contains 'امرأة' or display_text contains 'feminine, confident and intentional' or display_text contains 'أنثوية وواثقة' or display_text contains 'قصدية'
            assign display_title = 'امرأة LALEH'
            assign display_text = '<p>تتألق بأنوثة آسرة، وثقة هادئة، وخيارات واعية مدروسة.</p><p><br/>تُقدّر الرقي دون تكلف، وتنتقي تصاميمها بذوق أصيل لا تُمليه صيحات الموضة العابرة. صُممت LALEH لتكون جزءاً لا يتجزأ من أناقتها، ومناسباتها الخاصة، وأجمل اللحظات التي تخلد في ذاكرتها.</p>'
          endif

          assign display_title = display_title | replace: 'لماذا لاله', 'لماذا LALEH' | replace: 'امرأة لاله', 'امرأة LALEH' | replace: 'لاله', 'LALEH' | replace: 'لالة', 'LALEH'
          assign display_text = display_text | replace: 'لاله', 'LALEH' | replace: 'لالة', 'LALEH'
        endif
      %}
      <div
        class="m-image-with-text__content m:column m:w-full md:m:w-1/2 lg:m:w-{{ 12 | minus: section.settings.image_column_size }}/12 {% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
        {% if animated %}
          data-cascade
          style="--animation-order: 2;"
        {% endif %}
      >
        <div class="m-content-box m-richtext m-richtext--{{ section.settings.text_size }} m:w-full m:text-{{ section.settings.content_alignment }}">
          {% if display_sub_title != blank %}
            <p class="m-richtext__subtitle m-content-box__subheading {{ subtext_size }}">
              {{ display_sub_title }}
            </p>
          {% endif %}
          {% if display_title != blank %}
            <h3 class="m-richtext__title m-content-box__heading {{ heading_size }}">{{ display_title }}</h3>
          {% endif %}
          {% if display_text != blank %}
            <div class="m-richtext__description rte m-content-box__description {{ section.settings.desc_size | prepend: 'm:' }}">
              {{ display_text }}
            </div>
          {% endif %}
          {% if display_button_label != blank %}
            <div class="m-richtext__button">
              <a
                href="{{ section.settings.button_link | default: "#" }}"
                class="m-button {{ section.settings.button_style | replace: 'sf__btn-primary', 'm-button--primary' | replace: 'sf__btn-secondary', 'm-button--secondary' | replace: 'sf__btn-link', 'm-button--link' | replace: 'sf__btn-white', 'm-button--white' }} {{ section.settings.button_size }}"
              >
                {{- display_button_label -}}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
