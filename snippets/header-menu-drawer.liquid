{% liquid
  assign main_menu = section.settings.main_menu | default: 'main-menu'
  assign instagram_url = section.settings.social_instagram_link | default: settings.social_instagram_link | default: 'https://www.instagram.com/mylaleh.co'
  assign tiktok_url = section.settings.social_tiktok_link | default: settings.social_tiktok_link | default: 'https://www.tiktok.com/@mylaleh.co'

  assign is_ar = false
  if request.locale.iso_code contains 'ar' or localization.language.iso_code contains 'ar'
    assign is_ar = true
  endif
%}

<div id="m-menu-drawer" class="m-luxury-drawer">
  <div class="m-luxury-drawer__backdrop" data-drawer-close></div>
  <div
    class="m-luxury-drawer__panel m-gradient m-color-{{ section.settings.color_scheme }}"
    role="dialog"
    aria-modal="true"
    aria-label="{% if is_ar %}القائمة الرئيسية{% else %}Main Navigation{% endif %}"
  >
    <!-- Top Header: Elegant Minimal Close Button -->
    <div class="m-luxury-drawer__top">
      <button type="button" class="m-luxury-drawer__close-btn" data-drawer-close aria-label="{% if is_ar %}إغلاق القائمة{% else %}Close navigation{% endif %}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Scrollable Navigation Body -->
    <div class="m-luxury-drawer__body">
      <div class="m-luxury-drawer__nav active">
        {% if linklists[main_menu].links.size > 0 %}
          <ul class="m-luxury-drawer__nav-list">
            {% for link in linklists[main_menu].links %}
              {% liquid
                assign l_title = link.title
                if is_ar
                  assign l_clean = l_title | strip
                  if l_clean == 'Shop All' or l_clean contains 'تسوق الكل'
                    assign l_title = 'المجموعة'
                  endif
                  assign l_title = l_title | replace: 'لاله', 'LALEH' | replace: 'لالة', 'LALEH'
                elsif request.locale.iso_code contains 'fr'
                  assign l_title = l_title | replace: 'Foire aux questions', 'Questions fréquentes' | replace: 'foire aux questions', 'questions fréquentes'
                endif
              %}
              <li class="m-luxury-drawer__nav-item">
                {% if link.links != blank %}
                  <a
                    href="{{ link.url }}"
                    class="m-luxury-drawer__nav-link has-submenu"
                    data-open-submenu="sub-{{ forloop.index }}"
                  >
                    <span>{{ l_title }}</span>
                    <span class="m-luxury-drawer__chevron" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </span>
                  </a>

                  <!-- Submenu Slide Panel -->
                  <div id="sub-{{ forloop.index }}" class="m-luxury-drawer__submenu-panel">
                    <button type="button" class="m-luxury-drawer__back-btn" data-close-submenu>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                      <span>{{ l_title }}</span>
                    </button>
                    <ul class="m-luxury-drawer__nav-list">
                      {% for child in link.links %}
                        {% liquid
                          assign c_title = child.title
                          if is_ar
                            assign c_clean = c_title | strip
                            if c_clean == 'Shop All' or c_clean contains 'تسوق الكل'
                              assign c_title = 'المجموعة'
                            endif
                            assign c_title = c_title | replace: 'لاله', 'LALEH' | replace: 'لالة', 'LALEH'
                          elsif request.locale.iso_code contains 'fr'
                            assign c_title = c_title | replace: 'Foire aux questions', 'Questions fréquentes' | replace: 'foire aux questions', 'questions fréquentes'
                          endif
                        %}
                        <li class="m-luxury-drawer__nav-item">
                          <a href="{{ child.url }}" class="m-luxury-drawer__nav-link">
                            <span>{{ c_title }}</span>
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% else %}
                  <a href="{{ link.url }}" class="m-luxury-drawer__nav-link">
                    <span>{{ l_title }}</span>
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <!-- Curated Minimal Menu Hierarchy -->
          <div class="m-luxury-drawer__nav-section">
            <ul class="m-luxury-drawer__nav-list">
              <li class="m-luxury-drawer__nav-item">
                <a href="/collections/all" class="m-luxury-drawer__nav-link">
                  <span>{% if is_ar %}المجموعة الجديدة{% else %}New Collection{% endif %}</span>
                </a>
              </li>
              <li class="m-luxury-drawer__nav-item">
                <a href="/collections/all" class="m-luxury-drawer__nav-link">
                  <span>{% if is_ar %}المجموعة{% else %}Shop All{% endif %}</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="m-luxury-drawer__nav-section">
            <span class="m-luxury-drawer__section-title">{% if is_ar %}اكتشفي المزيد{% else %}DISCOVER{% endif %}</span>
            <ul class="m-luxury-drawer__nav-list">
              <li class="m-luxury-drawer__nav-item">
                <a href="/pages/about-us" class="m-luxury-drawer__nav-link">
                  <span>{% if is_ar %}عن LALEH{% else %}About LALEH{% endif %}</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="m-luxury-drawer__nav-section">
            <span class="m-luxury-drawer__section-title">{% if is_ar %}خدمة العملاء{% else %}CUSTOMER CARE{% endif %}</span>
            <ul class="m-luxury-drawer__nav-list">
              <li class="m-luxury-drawer__nav-item">
                <a href="/pages/faqs" class="m-luxury-drawer__nav-link">
                  <span>{% if is_ar %}الأسئلة الشائعة{% else %}FAQs{% endif %}</span>
                </a>
              </li>
              <li class="m-luxury-drawer__nav-item">
                <a href="/pages/contact" class="m-luxury-drawer__nav-link">
                  <span>{% if is_ar %}تواصل معنا{% else %}Contact{% endif %}</span>
                </a>
              </li>
            </ul>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Drawer Footer: Subtle Socials & Country / Language Selectors -->
    <div class="m-luxury-drawer__footer">
      <div class="m-luxury-drawer__footer-section">
        <span class="m-luxury-drawer__footer-label">{% if is_ar %}تابعونا{% else %}Social Media{% endif %}</span>
        <div class="m-luxury-drawer__socials">
          {% if instagram_url != blank %}
            <a
              href="{{ instagram_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="m-luxury-drawer__social-link"
              aria-label="Instagram"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          {% endif %}
          {% if tiktok_url != blank %}
            <a
              href="{{ tiktok_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="m-luxury-drawer__social-link"
              aria-label="TikTok"
              title="TikTok"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.81 4.48 6.27 6.27 0 0 0 1.9-4.47V8.65a8.28 8.28 0 0 0 4.88 1.57V6.77c-.334-.025-.668-.052-1-.08z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="m-luxury-drawer__footer-section">
        <span class="m-luxury-drawer__footer-label">Region &amp; Currency</span>
        <div class="m-luxury-drawer__localization">
          {% render 'country-selector', pos: 'top', box_size: 'm-drawer-country' %}
          {% render 'language-switcher', pos: 'top', box_size: 'm-drawer-language' %}
        </div>
      </div>
    </div>
  </div>
</div>
