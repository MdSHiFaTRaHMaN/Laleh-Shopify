{% liquid
  assign cart_count = cart.item_count
  assign featured_collection = collections.all | default: collections.first

  assign is_ar = false
  if request.locale.iso_code contains 'ar' or localization.language.iso_code contains 'ar'
    assign is_ar = true
  endif

  if is_ar
    assign t_add_to_bag = 'أضف إلى السلة'
    assign t_sold_out = 'نفدت الكمية'
  else
    assign t_add_to_bag = 'Add to Bag'
    assign t_sold_out = 'Sold Out'
  endif
%}

<div id="m-right-utility-drawer" class="m-luxury-right-drawer" aria-hidden="true">
  <div class="m-luxury-right-drawer__backdrop" data-close-right-drawer></div>
  <div
    class="m-luxury-right-drawer__panel m-gradient m-color-{{ section.settings.color_scheme }}"
    role="dialog"
    aria-modal="true"
    aria-label="Utility Navigation"
  >
    <!-- Top Header: Close Button & Tabs (Wishlist | Bag) -->
    <div class="m-luxury-right-drawer__header">
      <button
        type="button"
        class="m-luxury-right-drawer__close-btn"
        data-close-right-drawer
        aria-label="{{ 'general.accessibility.close' | t | default: 'Close drawer' }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="m-luxury-right-drawer__tabs" role="tablist">
        <button
          type="button"
          class="m-luxury-right-drawer__tab"
          id="tab-btn-search"
          data-tab-target="#right-tab-search"
          role="tab"
          aria-selected="false"
          style="display: none;"
        >
          {{ 'general.search.placeholder_short' | t | default: 'Search' }}
        </button>
        <button
          type="button"
          class="m-luxury-right-drawer__tab active"
          id="tab-btn-wishlist"
          data-tab-target="#right-tab-wishlist"
          role="tab"
          aria-selected="true"
        >
          {{ 'layout.wishlist.title' | t | default: 'Wishlist' }} (<span class="m-right-wishlist-count">0</span>)
        </button>
        <button
          type="button"
          class="m-luxury-right-drawer__tab"
          id="tab-btn-cart"
          data-tab-target="#right-tab-cart"
          role="tab"
          aria-selected="false"
        >
          {{ 'layout.cart.title' | t | default: 'Bag' }} (<span class="m-right-cart-count">{{ cart_count }}</span>)
        </button>
      </div>
    </div>

    <!-- Scrollable Content Body -->
    <div class="m-luxury-right-drawer__body">
      <!--
        ===================================================================
        TAB 1: SEARCH CONTENT (Real Predictive Search & Store Products)
        ===================================================================
      -->
      <div id="right-tab-search" class="m-luxury-right-drawer__pane active" role="tabpanel">
        <!-- Live Predictive Search Input -->
        <form action="{{ routes.search_url }}" method="get" class="m-right-search-form" role="search">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[unavailable_products]" value="last">
          <input type="hidden" name="options[prefix]" value="last">
          <div class="m-right-search-input-wrap">
            <input
              type="search"
              name="q"
              class="m-right-search-input"
              data-luxury-search-input
              placeholder="{{ 'general.search.placeholder' | t | default: 'Search products...' }}"
              autocomplete="off"
              aria-label="{{ 'general.search.title' | t | default: 'Search store' }}"
            >
            <button
              type="submit"
              class="m-right-search-btn"
              aria-label="{{ 'general.search.placeholder_short' | t | default: 'Search' }}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          </div>
        </form>

        <!-- Dynamic Live Search Results (Populated via JS when typing) -->
        <div id="m-right-live-search-results" class="m-right-live-search" style="display: none; margin-top: 18px;">
          <h4 class="m-right-drawer__section-title">{{ 'general.search.products' | t | default: 'Search Results' }}</h4>
          <div class="m-right-items-list" id="m-right-search-items-list"></div>
        </div>

        <!-- Default State: Real Recently Viewed / Featured Store Products -->
        <div id="m-right-search-default-view" class="m-right-drawer__section">
          <div class="m-right-drawer__section-header">
            <h4 class="m-right-drawer__section-title">
              {{ 'products.product.recently_viewed_products' | t | default: 'Recently viewed' }}
            </h4>
          </div>

          <!-- Dynamic Products Grid (Populated with real visited products or store products) -->
          <div class="m-right-product-grid" id="m-right-recent-products-grid">
            {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
              {%- for product in featured_collection.products limit: 4 -%}
                <div class="m-right-product-card" data-product-handle="{{ product.handle }}">
                  <a href="{{ product.url }}" class="m-right-product-card__image-wrap">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 400 }}"
                        alt="{{ product.title | escape }}"
                        loading="lazy"
                        width="{{ product.featured_image.width }}"
                        height="{{ product.featured_image.height }}"
                        class="m-right-product-card__img"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
                    {%- endif -%}
                  </a>
                  <div class="m-right-product-card__info" style="margin-top: 6px;">
                    <a
                      href="{{ product.url }}"
                      class="m-right-item-card__title notranslate"
                      translate="no"
                      style="display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; text-decoration: none;"
                    >
                      {% render 'product-title', product: product %}
                    </a>
                    <div class="m-right-item-card__price-row" style="margin-top: 2px;">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="m-right-price-compare">{{ product.compare_at_price | money | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                      {%- endif -%}
                      <span class="m-right-price-regular" data-base-price="{{ product.price }}">{{ product.price | money | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <!--
        ===================================================================
        TAB 2: WISHLIST CONTENT (Real Dynamic Saved Products)
        ===================================================================
      -->
      <div id="right-tab-wishlist" class="m-luxury-right-drawer__pane active" role="tabpanel">
        <div class="m-right-wishlist-pane-inner">
          <div class="m-right-wishlist-items-list" id="m-wishlist-items-container">
            <!-- Dynamically populated from localStorage['m-wishlist-products'] with real Shopify product data -->
            <div
              class="m-right-wishlist-loading"
              style="text-align: center; padding: 40px 0; color: rgba(var(--color-foreground), 0.6); font-size: 13.5px;"
            >
              {%- assign wishlist_loading = 'layout.wishlist.loading' | t -%}
              {%- if wishlist_loading contains 'Translation missing' or wishlist_loading == blank -%}
                {%- assign wishlist_loading = 'Loading your wishlist...' -%}
              {%- endif -%}
              {{ wishlist_loading }}
            </div>
          </div>
          <div class="m-right-wishlist-footer" id="m-right-wishlist-footer" style="display: none;">
            <a href="/pages/wishlist" class="m-right-view-wishlist-link">
              {%- assign wishlist_view_all = 'layout.wishlist.view_all' | t -%}
              {%- if wishlist_view_all contains 'Translation missing' or wishlist_view_all == blank -%}
                {%- assign wishlist_view_all = 'View your wishlist' -%}
              {%- endif -%}
              {{ wishlist_view_all }}
            </a>
          </div>
        </div>
      </div>

      <!--
        ===================================================================
        TAB 3: BAG / CART CONTENT (Real Shopify Cart Line Items & Ajax)
        ===================================================================
      -->
      <div id="right-tab-cart" class="m-luxury-right-drawer__pane" role="tabpanel">
        <div class="m-right-items-list" id="m-cart-items-container">
          {%- if cart.items.size > 0 -%}
            {%- for item in cart.items -%}
              <div class="m-right-item-card" data-cart-item-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
                <a href="{{ item.url }}" class="m-right-item-card__media">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 300 }}"
                      alt="{{ item.title | escape }}"
                      loading="lazy"
                      width="{{ item.image.width }}"
                      height="{{ item.image.height }}"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
                  {%- endif -%}
                </a>
                <div class="m-right-item-card__details">
                  <a href="{{ item.url }}" class="m-right-item-card__title notranslate" translate="no" style="text-decoration: none;">
                    {% render 'product-title', product: item.product, item: item %}
                  </a>
                  {%- unless item.product.has_only_default_variant -%}
                    <div
                      class="m-right-variant-text"
                      style="font-size: 12px; color: rgba(var(--color-foreground), 0.65); margin-top: 2px;"
                    >
                      {{ item.variant.title }}
                    </div>
                  {%- endunless -%}

                  <!-- Dynamic Quantity Stepper -->
                  <div class="m-right-qty-stepper" data-line-key="{{ item.key }}">
                    <button
                      type="button"
                      class="m-right-qty-btn minus"
                      data-ajax-qty-change="-1"
                      data-key="{{ item.key }}"
                      aria-label="{{ 'products.product.decrease_quantity' | t: title: item.title | default: 'Decrease quantity' }}"
                    >
                      -
                    </button>
                    <span class="m-right-qty-val" data-qty-display>{{ item.quantity }}</span>
                    <button
                      type="button"
                      class="m-right-qty-btn plus"
                      data-ajax-qty-change="1"
                      data-key="{{ item.key }}"
                      aria-label="{{ 'products.product.increase_quantity' | t: title: item.title | default: 'Increase quantity' }}"
                    >
                      +
                    </button>
                  </div>

                  <!-- Real Line Price -->
                  <div class="m-right-item-card__price-row" style="margin-top: 8px;">
                    {%- if item.original_line_price > item.final_line_price -%}
                      <span class="m-right-price-compare">{{ item.original_line_price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                    {%- endif -%}
                    <span class="m-right-price-regular" data-line-price data-base-price="{{ item.final_line_price }}">{{ item.final_line_price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                  </div>

                  <!-- Real Remove Button -->
                  <button type="button" class="m-right-remove-btn" data-ajax-remove-cart="{{ item.key }}">
                    {{ 'cart.general.remove' | t | default: 'Remove' }}
                  </button>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="m-right-cart-empty-state" style="text-align: center; padding: 40px 0;">
              <p style="color: rgba(var(--color-foreground), 0.6); font-size: 13.5px; margin-bottom: 16px;">
                {{ 'cart.general.empty' | t | default: 'Your bag is currently empty.' }}
              </p>
              <a
                href="{{ routes.all_products_collection_url }}"
                class="m-right-checkout-btn"
                style="text-decoration: none;"
              >
                {{ 'cart.general.start_shopping' | t | default: 'Start Shopping' }}
              </a>
            </div>
          {%- endif -%}
        </div>

        <!--
          ===================================================================
          COMPLETE YOUR COLLECTION (Grid Slider for Other Store Products)
          ===================================================================
        -->
        {% liquid
          assign cart_product_ids = cart.items | map: 'product_id'
          assign rec_collection = collections['favorite-laleh']
          if rec_collection == blank or rec_collection.products_count == 0
            assign rec_collection = collections.all
          endif
          if rec_collection == blank or rec_collection.products_count == 0
            assign rec_collection = collections.first
          endif
        %}

        <div
          class="m-right-collection-slider-section"
          id="m-right-complete-collection"
        >
          <div class="m-right-collection-slider-header">
            <h4 class="m-right-collection-slider-title">
              {{ 'cart.general.complete_collection' | t | default: 'Complete Your Collection' }}
            </h4>
            <div class="m-right-slider-nav">
              <button
                type="button"
                class="m-right-slider-nav-btn prev"
                data-coll-slider-prev
                aria-label="Previous products"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button
                type="button"
                class="m-right-slider-nav-btn next"
                data-coll-slider-next
                aria-label="Next products"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <div class="m-right-collection-slider-track" id="m-right-coll-slider-track">
            {%- assign shown_count = 0 -%}
            {%- for product in rec_collection.products -%}
              {%- unless cart_product_ids contains product.id -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
                {%- assign default_variant = product.selected_or_first_available_variant -%}
                <div class="m-right-coll-card" data-product-id="{{ product.id }}">
                  <div class="m-right-coll-card__media">
                    <a href="{{ product.url }}" class="m-right-coll-card__image-link">
                      {%- if product.featured_image -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 350 }}"
                          alt="{{ product.title | escape }}"
                          loading="lazy"
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                          class="m-right-coll-card__img"
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="m-right-coll-card__info">
                    <a href="{{ product.url }}" class="m-right-coll-card__title notranslate" translate="no">
                      {% render 'product-title', product: product %}
                    </a>
                    <div class="m-right-coll-card__price-row">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="m-right-price-compare">{{ product.compare_at_price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                      {%- endif -%}
                      <span class="m-right-price-regular" data-base-price="{{ product.price }}">{{ product.price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                    </div>

                    {%- unless product.has_only_default_variant -%}
                      {%- assign default_size_label = default_variant.title -%}
                      {%- for option_name in product.options -%}
                        {%- assign down_name = option_name | downcase -%}
                        {%- if down_name contains 'size' -%}
                          {%- assign default_size_label = default_variant.options[forloop.index0] -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <div class="m-right-coll-card__sizes" data-coll-sizes>
                        {%- for variant in product.variants -%}
                          {%- assign pill_label = variant.title -%}
                          {%- for option_name in product.options -%}
                            {%- assign down_name = option_name | downcase -%}
                            {%- if down_name contains 'size' -%}
                              {%- assign pill_label = variant.options[forloop.index0] -%}
                            {%- endif -%}
                          {%- endfor -%}
                          <button
                            type="button"
                            class="m-right-coll-size-pill{% if variant.id == default_variant.id %} is-selected{% endif %}{% unless variant.available %} is-sold-out{% endunless %}"
                            data-coll-size-pill
                            data-variant-id="{{ variant.id }}"
                            data-variant-price="{{ variant.price }}"
                            data-variant-price-formatted="{{ variant.price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}"
                            data-size="{{ pill_label | escape }}"
                            {% unless variant.available %}
                              disabled
                              aria-disabled="true"
                            {% endunless %}
                            title="{{ pill_label }}{% unless variant.available %} (Sold out){% endunless %}"
                          >
                            {{ pill_label }}
                          </button>
                        {%- endfor -%}
                      </div>
                    {%- endunless -%}

                    <button
                      type="button"
                      class="m-right-coll-add-btn"
                      data-coll-quick-add="{{ default_variant.id }}"
                      data-selected-size="{{ default_size_label }}"
                      {% unless product.available %}
                        disabled
                      {% endunless %}
                    >
                      {%- if product.available -%}
                        {%- if product.has_only_default_variant -%}
                          + {{ t_add_to_bag }}
                        {%- else -%}
                          + {{ t_add_to_bag }} • {{ default_size_label }}
                        {%- endif -%}
                      {%- else -%}
                        {{ t_sold_out }}
                      {%- endif -%}
                    </button>
                  </div>
                </div>
                {%- if shown_count >= 12 -%}{%- break -%}{%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
            {%- if shown_count == 0 -%}
              {%- for product in rec_collection.products limit: 6 -%}
                {%- assign default_variant = product.selected_or_first_available_variant -%}
                <div class="m-right-coll-card" data-product-id="{{ product.id }}">
                  <div class="m-right-coll-card__media">
                    <a href="{{ product.url }}" class="m-right-coll-card__image-link">
                      {%- if product.featured_image -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 350 }}"
                          alt="{{ product.title | escape }}"
                          loading="lazy"
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                          class="m-right-coll-card__img"
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="m-right-coll-card__info">
                    <a href="{{ product.url }}" class="m-right-coll-card__title notranslate" translate="no">
                      {% render 'product-title', product: product %}
                    </a>
                    <div class="m-right-coll-card__price-row">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="m-right-price-compare">{{ product.compare_at_price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                      {%- endif -%}
                      <span class="m-right-price-regular" data-base-price="{{ product.price }}">{{ product.price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
                    </div>

                    {%- unless product.has_only_default_variant -%}
                      {%- assign default_size_label = default_variant.title -%}
                      {%- for option_name in product.options -%}
                        {%- assign down_name = option_name | downcase -%}
                        {%- if down_name contains 'size' -%}
                          {%- assign default_size_label = default_variant.options[forloop.index0] -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <div class="m-right-coll-card__sizes" data-coll-sizes>
                        {%- for variant in product.variants -%}
                          {%- assign pill_label = variant.title -%}
                          {%- for option_name in product.options -%}
                            {%- assign down_name = option_name | downcase -%}
                            {%- if down_name contains 'size' -%}
                              {%- assign pill_label = variant.options[forloop.index0] -%}
                            {%- endif -%}
                          {%- endfor -%}
                          <button
                            type="button"
                            class="m-right-coll-size-pill{% if variant.id == default_variant.id %} is-selected{% endif %}{% unless variant.available %} is-sold-out{% endunless %}"
                            data-coll-size-pill
                            data-variant-id="{{ variant.id }}"
                            data-variant-price="{{ variant.price }}"
                            data-variant-price-formatted="{{ variant.price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}"
                            data-size="{{ pill_label | escape }}"
                            {% unless variant.available %}
                              disabled
                              aria-disabled="true"
                            {% endunless %}
                            title="{{ pill_label }}{% unless variant.available %} (Sold out){% endunless %}"
                          >
                            {{ pill_label }}
                          </button>
                        {%- endfor -%}
                      </div>
                    {%- endunless -%}

                    <button
                      type="button"
                      class="m-right-coll-add-btn"
                      data-coll-quick-add="{{ default_variant.id }}"
                      data-selected-size="{{ default_size_label }}"
                      {% unless product.available %}
                        disabled
                      {% endunless %}
                    >
                      {%- if product.available -%}
                        {%- if product.has_only_default_variant -%}
                          + {{ t_add_to_bag }}
                        {%- else -%}
                          + {{ t_add_to_bag }} • {{ default_size_label }}
                        {%- endif -%}
                      {%- else -%}
                        {{ t_sold_out }}
                      {%- endif -%}
                    </button>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <!--
      ===================================================================
      CART FOOTER (Pinned at Bottom for Bag Tab)
      ===================================================================
    -->
    <div
      class="m-luxury-right-drawer__footer{% if cart.item_count > 0 %} active{% endif %}{% if cart.item_count == 0 %} m:hidden{% endif %}"
      id="m-right-cart-footer"
    >
      <p class="m-right-shipping-note">
        {{ 'cart.general.free_shipping_note' | t | default: 'Shipping calculated at checkout.' }}
      </p>

      <div
        class="m-right-subtotal-row"
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 13.5px; font-weight: 500;"
      >
        <span>{{ 'cart.general.subtotal' | t | default: 'Subtotal' }}</span>
        <span id="m-right-cart-subtotal" data-base-price="{{ cart.total_price }}">{{ cart.total_price | money | strip_html | replace: 'Dhs.', 'AED ' | replace: 'Dhs', 'AED ' | replace: 'AED', 'AED ' | replace: 'CHF', 'CHF ' | replace: '$', '$ ' | replace: '€', '€ ' | replace: '£', '£ ' | replace: '৳', '৳ ' | replace: '₹', '₹ ' | replace: '¥', '¥ ' | replace: 'SAR', 'SAR ' | replace: 'QAR', 'QAR ' | replace: 'KWD', 'KWD ' | replace: 'CA$', 'CA$ ' | replace: 'A$', 'A$ ' | replace: 'kr', 'kr ' | replace: '  ', ' ' | strip }}</span>
      </div>

      <a href="/checkout" class="m-right-checkout-btn">
        {{ 'cart.general.checkout' | t | default: 'Proceed to checkout' }}
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="m-right-view-cart-link">
        {{ 'cart.general.explore_more' | t | default: 'Explore More' }}
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    window._LalehPredictiveSearchActive = true;

    const officialTitles = {
      'obsidian-touch': 'OBSIDIAN TOUCH',
      'structured-silence': 'STRUCTURED SILENCE',
      'vermeil': 'VERMEIL',
      'crimson-poise': 'CRIMSON POISE',
      'iris-pearl': 'IRIS PEARL',
      'lilac-verse': 'LILAC VERSE'
    };

    function getOfficialTitle(handle, fallback) {
      if (handle && officialTitles[handle]) return officialTitles[handle];
      const normHandle = String(handle || '').toLowerCase();
      for (const [k, v] of Object.entries(officialTitles)) {
        if (normHandle.includes(k) || k.includes(normHandle)) return v;
      }
      return fallback || '';
    }

    {% liquid
      assign drawer_search_catalog = collections.all.products
      if drawer_search_catalog == blank or drawer_search_catalog.size == 0
        assign drawer_search_catalog = collections['favorite-laleh'].products
      endif
    %}

    const localCatalog = [
      {%- for p in drawer_search_catalog limit: 12 -%}
        {%- capture p_off_title -%}{% render 'product-title', product: p %}{%- endcapture -%}
        {
          id: {{ p.id | json }},
          handle: {{ p.handle | json }},
          title: {{ p_off_title | strip | json }},
          url: {{ p.url | json }},
          image: {{ p.featured_image | image_url: width: 350 | json }},
          price: {{ p.price | json }},
          compare_at_price: {{ p.compare_at_price | default: 0 | json }},
          available: {{ p.available | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ];

    window._LalehCatalog = localCatalog;

    const productAttributes = {
      'obsidian-touch': {
        colors: ['black', 'dark', 'jet black', 'onyx', 'noir', 'noire', 'noires', 'sombre', 'obsidienne', 'اسود', 'سوداء', 'سودا', 'داكن'],
        names: ['obsidian touch', 'obsidian', 'touch', 'toucher d obsidienne', 'obsidienne', 'اوبسيديان تاتش', 'اوبسيديان', 'تاتش', 'لمسة', 'لمسه'],
        uniqueKeywords: ['cocktail', 'cocktail dress', 'sleeveless', 'sans manches', 'بدون اكمام', 'بدون أكمام', 'كوكتيل']
      },
      'vermeil': {
        colors: ['green', 'pale green', 'sage', 'mint', 'emerald', 'pastel green', 'vert', 'verte', 'vertes', 'vert pale', 'sauge', 'menthe', 'emeraude', 'اخضر', 'خضراء', 'خضرا', 'ميرميه', 'ميرمية', 'نعناعي', 'زمرد', 'زمردي'],
        names: ['vermeil', 'فيرميل'],
        uniqueKeywords: ['tweed', 'robe en tweed', 'تويد', 'فستان تويد', 'flared cuffs', 'deux pieces', 'deux pièces', 'ensemble', 'قطعتين', 'أكمام واسعة', 'اكمام واسعة']
      },
      'crimson-poise': {
        colors: ['crimson', 'red', 'pink', 'rose', 'raspberry', 'cramoisi', 'rouge', 'rose', 'framboise', 'قرمزي', 'احمر', 'حمراء', 'حمرا', 'وردي', 'زهري'],
        names: ['crimson poise', 'crimson', 'poise', 'equilibre cramoisi', 'équilibre cramoisi', 'cramoisi', 'كرمسون بويز', 'كرمسون', 'بويز'],
        uniqueKeywords: ['peplum', 'بيبلوم', 'lace', 'dentelle', 'دانتيل', 'long sleeves', 'manches longues', 'أكمام طويلة', 'اكمام طويلة', 'party', 'fete', 'fête', 'حفلات']
      },
      'lilac-verse': {
        colors: ['lilac', 'lavender', 'purple', 'violet', 'soft purple', 'lilas', 'lavande', 'pourpre', 'ليلاك', 'لافندر', 'بنفسجي', 'ارجواني', 'أرجواني'],
        names: ['lilac verse', 'verse', 'vers lilas', 'ليلاك فيرس', 'فيرس'],
        uniqueKeywords: ['high collar', 'col montant', 'ياقة عالية', 'lace', 'dentelle', 'دانتيل', 'paisley', 'بيزلي', 'romantic', 'romantique', 'رومانسي']
      },
      'iris-pearl': {
        colors: ['pearl', 'pearls', 'mauve', 'soft mauve', 'sheen', 'perle', 'perles', 'بيرل', 'لؤلؤ', 'لؤلؤي', 'لولو', 'موف', 'موف ناعم'],
        names: ['iris pearl', 'iris', 'perle', 'ايريس بيرل', 'ايريس'],
        uniqueKeywords: ['satin', 'robe en satin', 'ساتان', 'فستان ساتان', 'puffed sleeves', 'manches bouffantes', 'أكمام منفوخة', 'اكمام منفوخة']
      },
      'structured-silence': {
        colors: ['sand', 'beige', 'sand-beige', 'tan', 'cream', 'taupe', 'neutral', 'sable', 'creme', 'crème', 'neutre', 'رملي', 'بيج', 'كريمي'],
        names: ['structured silence', 'structured', 'silence', 'silence structure', 'silence structuré', 'structure', 'ستركتشر سايلنس', 'ستركتشر', 'سايلنس', 'صمت', 'منظم'],
        uniqueKeywords: ['suit', 'skirt', 'pencil skirt', 'sharp lapels', 'costume', 'tailleur', 'jupe', 'jupe crayon', 'revers pointus', 'طقم', 'بدلة', 'بدله', 'تنورة', 'تنوره', 'تنورة قلم', 'ياقة حادة']
      }
    };

    const genericDressTerms = [
      'dress', 'dresses', 'gown', 'gowns', 'midi', 'evening', 'luxury',
      'robe', 'robes', 'soiree', 'soirée', 'luxe',
      'فستان', 'فساتين', 'ثوب', 'ميدي', 'سهرة', 'فاخر',
      'laleh', 'لاليه', 'لاله', 'collection', 'women', 'femme', 'نساء', 'نسائي'
    ];

    const typoMap = {
      'dross': 'dress',
      'dres': 'dress',
      'dresse': 'dress',
      'drss': 'dress',
      'drees': 'dress',
      'dreses': 'dresses',
      'gwon': 'gown',
      'robr': 'robe',
      'robee': 'robe',
      'فستن': 'فستان',
      'فستانن': 'فستان',
      'blck': 'black',
      'balck': 'black',
      'blak': 'black',
      'blac': 'black',
      'gren': 'green',
      'geen': 'green',
      'grn': 'green',
      'pnk': 'pink',
      'pik': 'pink',
      'purpel': 'purple',
      'purp': 'purple',
      'purpl': 'purple',
      'lavendar': 'lavender',
      'beig': 'beige',
      'begie': 'beige',
      'mauv': 'mauve',
      'noie': 'noir',
      'noitr': 'noir',
      'vertte': 'verte',
      'obsidien': 'obsidian',
      'obsidion': 'obsidian',
      'obsidan': 'obsidian',
      'crimsn': 'crimson',
      'vermil': 'vermeil',
      'peral': 'pearl'
    };

    function normalizeArabic(str) {
      return (str || '')
        .replace(/[\u064B-\u065F\u0670]/g, '')
        .replace(/[إأآٱ]/g, 'ا')
        .replace(/[ى]/g, 'ي')
        .replace(/[ؤئ]/g, 'ء')
        .replace(/ة/g, 'ه');
    }

    function normalizeQuery(str) {
      if (!str) return '';
      let s = String(str).toLowerCase().trim();
      s = s.replace(/[«»"'`’‘.,;:!?#@$%^&*()_+=\-\[\]{}|\\/]/g, ' ');
      s = normalizeArabic(s);
      const rawTokens = s.split(/\s+/).filter(Boolean);
      const normalizedTokens = rawTokens.map(function(tok) { return typoMap[tok] || tok; });
      return normalizedTokens.join(' ');
    }

    const normalizedAttrCache = {};
    for (const [handle, attrs] of Object.entries(productAttributes)) {
      const normColors = attrs.colors.map(function(c) { return normalizeArabic(c.toLowerCase()); });
      const normNames = attrs.names.map(function(n) { return normalizeArabic(n.toLowerCase()); });
      const normUniques = attrs.uniqueKeywords.map(function(u) { return normalizeArabic(u.toLowerCase()); });
      normalizedAttrCache[handle] = {
        colors: normColors,
        names: normNames,
        uniqueKeywords: normUniques,
        allSpecific: [].concat(normColors, normNames, normUniques)
      };
    }

    const normGenericDress = genericDressTerms.map(function(d) { return normalizeArabic(d.toLowerCase()); });

    function getProductHandle(p) {
      if (!p) return '';
      if (p.handle) return p.handle;
      if (p.url) {
        const parts = p.url.split('/products/');
        if (parts[1]) return parts[1].split('?')[0].split('#')[0];
      }
      return '';
    }

    function scoreAndFilterProducts(rawQuery, candidateList) {
      const q = normalizeQuery(rawQuery);
      if (!q || q.length < 2) return [];

      const tokens = q.split(/\s+/).filter(Boolean);
      const foundQualifiersByProduct = {};
      let totalQualifiersFound = 0;

      for (const [handle, attrs] of Object.entries(normalizedAttrCache)) {
        foundQualifiersByProduct[handle] = [];

        for (let i = 0; i < attrs.allSpecific.length; i++) {
          const spec = attrs.allSpecific[i];
          if (spec.includes(' ') && q.includes(spec)) {
            foundQualifiersByProduct[handle].push({ term: spec, weight: 10000 });
            totalQualifiersFound++;
          }
        }

        for (let t = 0; t < tokens.length; t++) {
          const tok = tokens[t];
          if (tok.length < 2) continue;
          if (normGenericDress.includes(tok)) continue;

          for (let i = 0; i < attrs.allSpecific.length; i++) {
            const spec = attrs.allSpecific[i];
            if (spec === tok) {
              foundQualifiersByProduct[handle].push({ term: spec, weight: 8000 });
              totalQualifiersFound++;
              break;
            } else if (tok.length >= 4 && (spec.startsWith(tok) || tok.startsWith(spec))) {
              foundQualifiersByProduct[handle].push({ term: spec, weight: 4000 });
              totalQualifiersFound++;
              break;
            }
          }
        }
      }

      for (const [handle, offTitle] of Object.entries(officialTitles)) {
        const normTitle = offTitle.toLowerCase();
        if (normTitle === q) {
          if (!foundQualifiersByProduct[handle]) foundQualifiersByProduct[handle] = [];
          foundQualifiersByProduct[handle].push({ term: normTitle, weight: 15000 });
          totalQualifiersFound++;
        } else if (normTitle.includes(q) && q.length >= 3) {
          if (!foundQualifiersByProduct[handle]) foundQualifiersByProduct[handle] = [];
          foundQualifiersByProduct[handle].push({ term: normTitle, weight: 9000 });
          totalQualifiersFound++;
        }
      }

      const isGenericQuery = tokens.some(function(t) { return normGenericDress.includes(t); }) ||
                             normGenericDress.some(function(d) { return q.includes(d); });

      const scored = [];

      for (let i = 0; i < candidateList.length; i++) {
        const p = candidateList[i];
        const handle = getProductHandle(p);
        const qualifiers = foundQualifiersByProduct[handle] || [];
        let score = 0;

        for (let k = 0; k < qualifiers.length; k++) {
          score += qualifiers[k].weight;
        }

        if (totalQualifiersFound > 0) {
          if (qualifiers.length === 0) {
            score = 0;
          } else if (isGenericQuery) {
            score += 2000;
          }
        } else if (isGenericQuery) {
          score = 5000;
        }

        if (score > 0) {
          scored.push({ product: p, score: score });
        }
      }

      scored.sort(function(a, b) { return b.score - a.score; });

      if (scored.length > 0) {
        const topScore = scored[0].score;
        if (topScore >= 7000) {
          return scored.filter(function(item) { return item.score >= topScore * 0.4; }).map(function(item) { return item.product; });
        }
      }

      return scored.map(function(item) { return item.product; });
    }

    window._scoreAndFilterProducts = scoreAndFilterProducts;
    window._normalizeSearchQuery = normalizeQuery;


    function parseSearchPriceToCents(val) {
      if (val == null) return 0;
      if (typeof val === 'number') {
        return val > 1000 ? Math.round(val) : Math.round(val * 100);
      }
      const clean = parseFloat(String(val).replace(/[^0-9.-]/g, ''));
      if (isNaN(clean)) return 0;
      return Math.round(clean * 100);
    }

    function formatMoneyStr(cents) {
      if (window.CurrencyEngine && typeof window.CurrencyEngine.formatMoney === 'function') {
        return window.CurrencyEngine.formatMoney(cents, window.CurrencyEngine.getActiveCurrency());
      }
      if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
        return Shopify.formatMoney(cents);
      }
      return (cents / 100).toFixed(2);
    }

    function getNoProductsFoundMessage(rawQuery) {
      const lang = (document.documentElement.lang || '').toLowerCase();
      const path = window.location.pathname;
      const isFr = lang.startsWith('fr') || path.startsWith('/fr');
      const isAr = lang.startsWith('ar') || path.startsWith('/ar');
      const safeQuery = String(rawQuery || '').trim();

      if (isFr) {
        return 'Aucun produit trouvé pour « ' + safeQuery + ' ».';
      }
      if (isAr) {
        return 'لم يتم العثور على منتجات لـ "' + safeQuery + '".';
      }
      return 'No products found for "' + safeQuery + '".';
    }

    let debounceTimer = null;

    async function handlePredictiveSearch(query) {
      const liveResults = document.getElementById("m-right-live-search-results");
      const defaultView = document.getElementById("m-right-search-default-view");
      const itemsList = document.getElementById("m-right-search-items-list");
      if (!liveResults || !itemsList) return;

      if (defaultView) defaultView.style.display = "none";
      liveResults.style.display = "block";
      const searchingText = window.MinimogStrings?.searchingStore || "Searching store...";
      itemsList.innerHTML = '<div style="text-align: center; padding: 20px 0; color: rgba(var(--color-foreground), 0.6); font-size: 13px;">' + searchingText + '</div>';

      try {
        const suggestBase = '{{ routes.predictive_search_url }}' || '/search/suggest.json';
        const searchUrl = suggestBase + '?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=10&resources[options][unavailable_products]=last';

        let products = [];
        try {
          const res = await fetch(searchUrl);
          if (res.ok) {
            const data = await res.json();
            products = data?.resources?.results?.products || [];
          }
        } catch(e) {
          console.warn("Suggest endpoint fallback:", e);
        }

        if (!window._LalehLocalizedPrices) window._LalehLocalizedPrices = {};
        products.forEach(function(p) {
          if (p.handle && p.price) {
            window._LalehLocalizedPrices[p.handle] = {
              price: parseSearchPriceToCents(p.price),
              compare_at_price: p.compare_at_price ? parseSearchPriceToCents(p.compare_at_price) : 0
            };
          }
        });

        const candidateMap = new Map();
        (products || []).forEach(function(p) {
          const h = getProductHandle(p);
          if (h) candidateMap.set(h, p);
        });
        (localCatalog || []).forEach(function(p) {
          const h = getProductHandle(p);
          if (h) {
            if (!candidateMap.has(h)) {
              candidateMap.set(h, p);
            } else {
              const existing = candidateMap.get(h);
              if (!existing.image && p.image) existing.image = p.image;
              if (!existing.url && p.url) existing.url = p.url;
            }
          }
        });
        const candidatePool = Array.from(candidateMap.values());
        const scoredItems = scoreAndFilterProducts(query, candidatePool);

        if (scoredItems.length === 0) {
          itemsList.innerHTML = '<div style="text-align: center; padding: 28px 12px; color: rgba(var(--color-foreground), 0.65); font-size: 13px; line-height: 1.5;">' +
            getNoProductsFoundMessage(query) +
          '</div>';
          return;
        }

        itemsList.innerHTML = scoredItems.map(function(p) {
          const img = p.image || p.featured_image || "";
          const handle = p.handle || (p.url ? p.url.split('/products/')[1]?.split('?')[0] : '');
          const officialTitle = getOfficialTitle(handle, p.title);
          const priceCents = parseSearchPriceToCents(p.price);
          const compPriceCents = p.compare_at_price ? parseSearchPriceToCents(p.compare_at_price) : 0;
          const priceFormatted = formatMoneyStr(priceCents);
          const compareFormatted = compPriceCents > priceCents ? '<span class="m-right-price-compare" data-base-price="' + compPriceCents + '">' + formatMoneyStr(compPriceCents) + '</span>' : '';

          return '<div class="m-right-item-card" style="padding-bottom: 12px;">' +
            '<a href="' + p.url + '" class="m-right-item-card__media" style="width: 70px; height: 90px;">' +
              (img ? '<img src="' + img + '" alt="' + officialTitle + '" loading="lazy">' : '<div style="width:100%;height:100%;background:#f3f3f3;"></div>') +
            '</a>' +
            '<div class="m-right-item-card__details" style="justify-content: center;">' +
              '<a href="' + p.url + '" class="m-right-item-card__title notranslate" translate="no" style="text-decoration: none; font-size: 13px; font-weight: 500; text-transform: uppercase;">' +
                officialTitle +
              '</a>' +
              '<div class="m-right-item-card__price-row" style="margin-top: 4px;">' +
                compareFormatted +
                '<span class="m-right-price-regular" data-base-price="' + priceCents + '" style="font-size: 12.5px;">' + priceFormatted + '</span>' +
              '</div>' +
            '</div>' +
          '</div>';
        }).join("");

        if (window.CurrencyEngine && typeof window.CurrencyEngine.ensurePriceSpacing === 'function') {
          window.CurrencyEngine.ensurePriceSpacing(itemsList);
        }
      } catch(err) {
        console.error("Predictive search error:", err);
        itemsList.innerHTML = '<div style="text-align: center; padding: 24px 12px; color: rgba(var(--color-foreground), 0.65); font-size: 13px;">' +
          getNoProductsFoundMessage(query) +
        '</div>';
      }
    }

    document.addEventListener("input", function(e) {
      const input = e.target.closest("[data-luxury-search-input]");
      if (!input) return;

      const query = input.value.trim();
      if (debounceTimer) clearTimeout(debounceTimer);

      if (!query || query.length < 2) {
        const liveResults = document.getElementById("m-right-live-search-results");
        const defaultView = document.getElementById("m-right-search-default-view");
        if (liveResults) liveResults.style.display = "none";
        if (defaultView) defaultView.style.display = "block";
        return;
      }

      debounceTimer = setTimeout(function() {
        handlePredictiveSearch(query);
      }, 150);
    });

    document.addEventListener("submit", function(e) {
      const form = e.target.closest(".m-right-search-box");
      if (!form) return;
      const input = form.querySelector("[data-luxury-search-input]");
      if (!input) return;
      const query = input.value.trim();
      if (!query) return;

      const candidateList = (localCatalog && localCatalog.length > 0) ? localCatalog : [];
      const matches = scoreAndFilterProducts(query, candidateList);

      // If exactly 1 product matched (e.g. "black dross" -> Obsidian Touch), go directly to it
      if (matches.length === 1 && matches[0].url) {
        e.preventDefault();
        window.location.href = matches[0].url;
        return;
      }

      // If typo was normalized, redirect to search page with normalized query
      const normQ = normalizeQuery(query);
      if (normQ && normQ !== query.toLowerCase().trim()) {
        e.preventDefault();
        const action = form.getAttribute("action") || "/search";
        window.location.href = action + "?q=" + encodeURIComponent(normQ);
        return;
      }
    });
  })();
</script>

