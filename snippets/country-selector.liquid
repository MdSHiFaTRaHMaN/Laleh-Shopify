{% unless form_id %}
  {% assign random_number = 'now' | date: '%N' | modulo: 10 | plus: 25 %}
  {% assign form_id = 'country-' | append: random_number %}
{% endunless %}
{% assign current_country_code = localization.country.iso_code | default: 'CH' %}
{% assign current_country_name = localization.country.name | default: 'Switzerland' %}

<style>
  .m-country-flag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-right: 6px;
    vertical-align: middle;
  }
  .m-country-flag-icon svg {
    width: 17px;
    height: 17px;
    display: block;
    border-radius: 50%;
  }
  .m-country-flag-icon .m-country-flags {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }
</style>

{% if localization.available_countries.size > 1 %}
  <div class="m-switcher-dropdown m-country-switcher {{ box_size }}">
    {% form 'localization', data-localization-form: '', id: form_id %}
      <input type="hidden" name="country_code" value="{{ current_country_code }}" data-localization-input>
      <m-select-component>
        <m-localization-form>
          <select name="country_code" class="js-selectNative" data-localization-select>
            {%- for country in localization.available_countries -%}
              {%- assign c_curr = country.currency.iso_code -%}
              <option
                value="{{ country.iso_code }}"
                data-currency="{{ c_curr }}"
                {% if country.iso_code == current_country_code %}
                  selected
                {% endif %}
              >
                {{ country.name }} ({{ c_curr }})
              </option>
            {%- endfor -%}
          </select>
        </m-localization-form>
        <div class="m-select-custom js-selectCustom" aria-hidden="true">
          <div class="m-select-custom--trigger">
            <span class="m-country-flag-icon">
              {% if current_country_code == 'CH' %}
                <svg viewBox="0 0 512 512" width="16" height="16" style="display: block; border-radius: 50%;">
                  <circle cx="256" cy="256" r="256" fill="#D52B1E"/>
                  <path fill="#FFFFFF" d="M216 116h80v100h100v80H296v100h-80V296H116v-80h100V116z"/>
                </svg>
              {% else %}
                <span class="m-country-flags m-country-flags--{{ current_country_code }}"></span>
              {% endif %}
            </span>
            <span class="m-select-custom--trigger-text">{{ current_country_name }}</span>
            <span class="m-select-custom--trigger-icon">
              <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 1L5 5L9 1"/>
              </svg>
            </span>
          </div>
          <div class="m-select-custom--options m-select-custom--options-{{ pos }}">
            {%- for country in localization.available_countries -%}
              {%- assign c_curr = country.currency.iso_code -%}
              <div class="m-select-custom--option" data-value="{{ country.iso_code }}" data-currency="{{ c_curr }}">
                {% if country.iso_code == 'CH' %}
                  <svg viewBox="0 0 512 512" width="14" height="14" style="display: inline-block; vertical-align: middle; border-radius: 50%; margin-right: 6px;">
                    <circle cx="256" cy="256" r="256" fill="#D52B1E"/>
                    <path fill="#FFFFFF" d="M216 116h80v100h100v80H296v100h-80V296H116v-80h100V116z"/>
                  </svg>
                {% else %}
                  <span class="m-country-flags m-country-flags--{{ country.iso_code }}"></span>
                {% endif %}
                {{ country.name }} ({{ c_curr }})
              </div>
            {%- endfor -%}
          </div>
        </div>
      </m-select-component>
      <script>
        (function() {
          try {
            var c = localStorage.getItem('m_active_country');
            if (c) {
              var s = document.currentScript;
              var root = s ? s.previousElementSibling : null;
              if (root && root.tagName === 'M-SELECT-COMPONENT') {
                var sel = root.querySelector('.js-selectNative');
                var txt = root.querySelector('.m-select-custom--trigger-text');
                var flg = root.querySelector('.m-country-flag-icon');
                var opt = root.querySelector('.m-select-custom--option[data-value="' + c.toUpperCase() + '"]');
                if (c.toUpperCase() === 'CH') {
                  if (txt) txt.textContent = 'Switzerland';
                  if (flg) flg.innerHTML = '<svg viewBox="0 0 512 512" width="16" height="16" style="display: block; border-radius: 50%;"><circle cx="256" cy="256" r="256" fill="#D52B1E"/><path fill="#FFFFFF" d="M216 116h80v100h100v80H296v100h-80V296H116v-80h100V116z"/></svg>';
                  if (sel) sel.value = 'CH';
                  if (!localStorage.getItem('m_active_currency')) {
                    localStorage.setItem('m_active_currency', 'CHF');
                  }
                } else if (opt) {
                  if (txt) txt.textContent = opt.textContent.trim();
                  var optFlag = opt.querySelector('svg, .m-country-flags, img');
                  if (flg && optFlag) flg.innerHTML = optFlag.outerHTML;
                  if (sel) sel.value = c.toUpperCase();
                  var curr = opt.getAttribute('data-currency');
                  if (curr && !localStorage.getItem('m_active_currency')) {
                    localStorage.setItem('m_active_currency', curr);
                  }
                }
              }
            }
          } catch(e) {}
        })();
      </script>
    {%- endform -%}
  </div>
{% else %}
  {% assign fallback_countries = "Switzerland:CH:CHF,United States:US:USD,United Kingdom:GB:GBP,Germany:DE:EUR,France:FR:EUR,Canada:CA:CAD,Australia:AU:AUD,Japan:JP:JPY,United Arab Emirates:AE:AED" | split: "," %}
  <div class="m-switcher-dropdown m-country-switcher {{ box_size }}">
    {% form 'localization', data-localization-form: '', id: form_id %}
      <input type="hidden" name="country_code" value="{{ current_country_code }}" data-localization-input>
      <m-select-component>
        <m-localization-form>
          <select name="country_code" class="js-selectNative" data-localization-select>
            {%- for item in fallback_countries -%}
              {% assign parts = item | split: ":" %}
              <option
                value="{{ parts[1] }}"
                data-currency="{{ parts[2] }}"
                {% if parts[1] == current_country_code %}
                  selected
                {% endif %}
              >
                {{ parts[0] }}
              </option>
            {%- endfor -%}
          </select>
        </m-localization-form>
        <div class="m-select-custom js-selectCustom" aria-hidden="true">
          <div class="m-select-custom--trigger">
            <span class="m-country-flag-icon">
              {% if current_country_code == 'CH' %}
                <svg viewBox="0 0 512 512" width="16" height="16" style="display: block; border-radius: 50%;">
                  <circle cx="256" cy="256" r="256" fill="#D52B1E"/>
                  <path fill="#FFFFFF" d="M216 116h80v100h100v80H296v100h-80V296H116v-80h100V116z"/>
                </svg>
              {% else %}
                <span class="m-country-flags m-country-flags--{{ current_country_code }}"></span>
              {% endif %}
            </span>
            <span class="m-select-custom--trigger-text">{{ current_country_name }}</span>
            <span class="m-select-custom--trigger-icon">
              <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 1L5 5L9 1"/>
              </svg>
            </span>
          </div>
          <div class="m-select-custom--options m-select-custom--options-{{ pos }}">
            {%- for item in fallback_countries -%}
              {% assign parts = item | split: ":" %}
              <div class="m-select-custom--option" data-value="{{ parts[1] }}" data-currency="{{ parts[2] }}">
                {% if parts[1] == 'CH' %}
                  <svg viewBox="0 0 512 512" width="14" height="14" style="display: inline-block; vertical-align: middle; border-radius: 50%; margin-right: 6px;">
                    <circle cx="256" cy="256" r="256" fill="#D52B1E"/>
                    <path fill="#FFFFFF" d="M216 116h80v100h100v80H296v100h-80V296H116v-80h100V116z"/>
                  </svg>
                {% else %}
                  <span class="m-country-flags m-country-flags--{{ parts[1] }}"></span>
                {% endif %}
                {{ parts[0] }}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </m-select-component>
      <script>
        (function() {
          try {
            var c = localStorage.getItem('m_active_country');
            if (c) {
              var s = document.currentScript;
              var root = s ? s.previousElementSibling : null;
              if (root && root.tagName === 'M-SELECT-COMPONENT') {
                var sel = root.querySelector('.js-selectNative');
                var txt = root.querySelector('.m-select-custom--trigger-text');
                var flg = root.querySelector('.m-country-flag-icon');
                var opt = root.querySelector('.m-select-custom--option[data-value="' + c.toUpperCase() + '"]');
                if (c.toUpperCase() === 'CH') {
                  if (txt) txt.textContent = 'Switzerland';
                  if (flg) flg.innerHTML = '<svg viewBox="0 0 512 512" width="16" height="16" style="display: block; border-radius: 50%;"><circle cx="256" cy="256" r="256" fill="#D52B1E"/><path fill="#FFFFFF" d="M216 116h80v100h100v80H296v100h-80V296H116v-80h100V116z"/></svg>';
                  if (sel) sel.value = 'CH';
                  if (!localStorage.getItem('m_active_currency')) {
                    localStorage.setItem('m_active_currency', 'CHF');
                  }
                } else if (opt) {
                  if (txt) txt.textContent = opt.textContent.trim();
                  var optFlag = opt.querySelector('svg, .m-country-flags, img');
                  if (flg && optFlag) flg.innerHTML = optFlag.outerHTML;
                  if (sel) sel.value = c.toUpperCase();
                  var curr = opt.getAttribute('data-currency');
                  if (curr && !localStorage.getItem('m_active_currency')) {
                    localStorage.setItem('m_active_currency', curr);
                  }
                }
              }
            }
          } catch(e) {}
        })();
      </script>
    {%- endform -%}
  </div>
{% endif %}
