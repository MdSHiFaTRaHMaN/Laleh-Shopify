<!-- /snippets/breadcrumb.liquid -->
{% comment %}
  Documentation - http://docs.shopify.com/support/your-website/navigation/creating-a-breadcrumb-navigation
{% endcomment %}
{% comment %}
  Accepts:
  - container: {String} Container class (optional)
  - justify: {String} Defines how the browser distributes space between and around content items along the main-axis of a flex container (optional)
  - class: {String} Extra classes (optional)
  - hide_current: {Boolean} Hide current item (optional)

  Usage:
  {% render 'breadcrumb' %}
{% endcomment %}
{%- liquid
  if container != nil and container == 'w-full'
    assign container = 'container-full'
  endif
  if container == nil
    assign container = 'container-fluid'
  endif

  if animated == nil
    assign animated = false
  endif
  if animation_effect == nil
    assign animation_effect = settings.animations
  endif

  if animation_effect != 'none'
    assign animated = true
  endif
-%}

{%- liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
  assign is_fr = false
  if request.locale.iso_code contains 'fr'
    assign is_fr = true
  endif

  assign home_text = 'general.breadcrumbs.home' | t
  assign home_title = 'general.breadcrumbs.home_link_title' | t
  if is_ar or home_text == 'Home' or home_text contains 'translation missing'
    if is_ar
      assign home_text = 'الرئيسية'
      assign home_title = 'العودة إلى الصفحة الرئيسية'
    endif
  endif
  if is_fr
    if home_text == 'Home' or home_text contains 'translation missing'
      assign home_text = 'Accueil'
      assign home_title = "Retour à la page d'accueil"
    endif
  endif
-%}
{%- capture separator -%}
    <span aria-hidden="true" class="m-breadcrumb--separator">
      <svg class="m-svg-icon--small m-rlt-reverse-x" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512"><path d="M17.525 36.465l-7.071 7.07c-4.686 4.686-4.686 12.284 0 16.971L205.947 256 10.454 451.494c-4.686 4.686-4.686 12.284 0 16.971l7.071 7.07c4.686 4.686 12.284 4.686 16.97 0l211.051-211.05c4.686-4.686 4.686-12.284 0-16.971L34.495 36.465c-4.686-4.687-12.284-4.687-16.97 0z"/></svg>
    </span>
{%- endcapture -%}

{%- capture home -%}
    <a href="{{ routes.root_url }}" class="m-breadcrumb--item" title="{{ home_title }}">
        {{ home_text }}
    </a>
{%- endcapture -%}

{% unless template == 'index' %}
  <nav
    class="m-breadcrumb m:w-full {{ class }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
    role="navigation"
    aria-label="{% if is_ar %}مسار التنقل{% elsif is_fr %}fil d'Ariane{% else %}breadcrumbs{% endif %}"
  >
    <div class="{{ container }}">
      <div class="m-breadcrumb--wrapper m:flex m:items-center m:justify-{{ justify | default: 'start' }}">
        {% unless template.name == 'product' %}
          {{ home }}
        {% endunless %}

        {% if template.name == 'product' %}
          {{ home }}
          {% liquid
            assign current_collection = null
            if collection
              assign current_collection = collection
            elsif product and product.collections.size > 0
              assign current_collection = product.collections.first
            endif

            assign primary_collection = product.metafields.breadcrumbs.primary_collection
          %}
          {%- if collection.url != blank -%}
            {{ separator }}
            {%- if primary_collection != blank -%}
              {{ primary_collection.value.title | link_to: primary_collection.value.url, class: 'm-breadcrumb--item' }}
            {%- else -%}
              {{ collection.title | link_to: collection.url, class: 'm-breadcrumb--item' }}
            {%- endif -%}
          {%- else -%}
            {%- assign current_collection = product.collections | first -%}
            {{ separator }}
            {%- if primary_collection != blank -%}
              <a href="{{ primary_collection.value.url }}" class="m-breadcrumb--item">
                {{- primary_collection.value.title -}}
              </a>
            {%- elsif current_collection != blank -%}
              <a href="{{ current_collection.url }}" class="m-breadcrumb--item">
                {{- current_collection.title -}}
              </a>
            {%- else -%}
              {%- liquid
                assign coll_label = 'products.product.collection' | t
                if is_ar or coll_label == 'Collection' or coll_label contains 'translation missing'
                  if is_ar
                    assign coll_label = 'المجموعة'
                  endif
                endif
              -%}
              <a href="{{ routes.all_products_collection_url }}" class="m-breadcrumb--item">{{ coll_label }}</a>
            {%- endif -%}
          {%- endif -%}
          {{ separator }}
          <span class="m-breadcrumb--item-current m-breadcrumb--item notranslate" translate="no">{% render 'product-title', product: product %}</span>

        {% elsif template.name == 'collection' and collection.handle %}
          {{ separator }}
          {% if current_tags %}
            {% capture url %}{{ routes.collections_url }}/{{ collection.handle }}{% endcapture %}
            <a href="{{ url }}" class="m-breadcrumb--item">{{ collection.title }}</a>
            {{ separator }}
            <span class="m-breadcrumb--item m-breadcrumb--item-current">{{ current_tags | join: ' + ' }}</span>
          {% else %}
            <span class="m-breadcrumb--item m-breadcrumb--item-current">{{ collection.title }}</span>
          {% endif %}

        {% elsif template.name == 'blog' %}
          {{ separator }}
          {% if current_tags %}
            <a href="{{ blog.url }}" class="m-breadcrumb--item">{{ blog.title }}</a>
            {{ separator }}
            <span class="m-breadcrumb--item m-breadcrumb--item-current">{{ current_tags | join: ' + ' }}</span>
          {% else %}
            <span class="m-breadcrumb--item-current m-breadcrumb--item">{{ blog.title }}</span>
          {% endif %}

        {% elsif template == 'article' %}
          {{ separator }}
          <a href="{{ blog.url }}" class="m-breadcrumb--item">{{ blog.title }}</a>

        {% elsif template == 'customers/addresses' %}
          {{ separator }}
          {%- liquid
            assign acc_title = 'customer.account.page_title' | t
            if is_ar
              assign acc_title = 'حسابي'
            endif
          -%}
          <a href="{{ routes.account_url }}" class="m-breadcrumb--item">{{ acc_title }}</a>
          {{ separator }}
          <span class="m-breadcrumb--item-current m-breadcrumb--item">{{ page_title }}</span>

        {% elsif template contains 'page' %}
          {{ separator }}
          {% liquid
            assign p_display_title = page.title
            if is_ar
              assign p_display_title = p_display_title | replace: 'لاله', 'LALEH' | replace: 'لالة', 'LALEH'
            elsif is_fr
              assign p_display_title = p_display_title | replace: 'Foire aux questions', 'Questions fréquentes' | replace: 'foire aux questions', 'questions fréquentes'
            endif
          %}
          <span class="m-breadcrumb--item-current m-breadcrumb--item">{{ p_display_title }}</span>

        {% elsif template contains 'search' %}
          {{ separator }}
          <span class="m-breadcrumb--item-current m-breadcrumb--item">
            {{- 'general.search.heading' | t: count: search.results_count, terms: search.terms -}}
          </span>

        {% else %}
          {{ separator }}
          {% liquid
            assign pt_display = page_title
            if is_ar
              assign pt_display = pt_display | replace: 'لاله', 'LALEH' | replace: 'لالة', 'LALEH'
            elsif is_fr
              assign pt_display = pt_display | replace: 'Foire aux questions', 'Questions fréquentes' | replace: 'foire aux questions', 'questions fréquentes'
            endif
          %}
          <span class="m-breadcrumb--item-current m-breadcrumb--item">{{ pt_display }}</span>
        {% endif %}
      </div>
    </div>
  </nav>
{% endunless %}
